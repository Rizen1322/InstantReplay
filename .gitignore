# В репозиторий едет исходник приложения (src\Aura), тесты, сборочные скрипты и README.
# Установщик распространяется готовым файлом в релизе, а не исходниками в репозитории.

# Сборочные артефакты .NET
[Bb]in/
[Oo]bj/

# Установщик и распакованный payload — собираются build_setup.ps1, в репозиторий не кладутся
dist/

# Тяжёлый архив с исходниками/бэкапом
InstantReplay.7z

# Отладочные выхлопы XAML-компилятора (xamlout.txt/xamlerr.txt рядом с проектом)
xaml[oe]*.txt

# Старое дерево под прежним именем: приложение живёт в src\Aura.
# Правило явное, чтобы `git add -A` в release.ps1 не втащил папку обратно.
src/InstantReplay/

# Проект установщика и его музыка (WAV на 37 МБ) — только локально.
# В релиз уходит готовый InstantReplaySetup.exe, собранный build_setup.ps1.
src/InstantReplaySetup/
setup_music.wav

# КЛЮЧИ ПОДПИСИ — никогда и ни при каких обстоятельствах.
# Закрытый ключ, попавший в репозиторий, обесценивает всю проверку обновлений.
*.pem
*.pfx
*.snk
release-key*

# Пользовательские данные IDE
.vs/
*.user

# Локальные настройки Claude Code этой машины
.claude/settings.local.json

# npm-зависимости (headroom-ai и т.п.) — ставятся локально через npm install
node_modules/
