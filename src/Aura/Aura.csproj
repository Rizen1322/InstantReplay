<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- TFM с версией Windows SDK: WPF + проекции WinRT (Windows.Graphics.Capture,
         Windows.Storage) в одном проекте. Windows App SDK больше не нужен. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Aura</RootNamespace>
    <AssemblyName>Aura</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.1.105.0</AssemblyVersion>
    <FileVersion>1.1.105.0</FileVersion>
    <Version>1.1.105</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GameCaptureHookOutput>$(MSBuildProjectDirectory)\..\..\artifacts\native\win-x64\Release</GameCaptureHookOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct3D11 / DXGI / Media Foundation -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <!-- Компиляция шейдера, который дорисовывает курсор в кадр Desktop Duplication -->
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <!-- WASAPI-захват и ресемплинг -->
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="NAudio.Core" Version="2.3.0" />
    <!-- Иконка в трее (WPF-вариант того же пакета) -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <!-- WMI -->
    <PackageReference Include="System.Management" Version="10.0.12" />
    <!-- Самодостаточный предпросмотр редактора: движок и кодеки приезжают вместе
         с Aura, Windows Media Player и его optional feature не нужны. -->
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Шрифты вшиты в сборку: интерфейс выглядит одинаково на любой машине -->
    <Resource Include="Fonts\*.ttf" />
    <Content Include="$(GameCaptureHookOutput)\Aura.GameCaptureHook64.dll"
             Link="Aura.GameCaptureHook64.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GameCaptureHookOutput)\Aura.GameCaptureHook64.sha256"
             Link="Aura.GameCaptureHook64.sha256"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(GameCaptureHookOutput)\Aura.GameCaptureHook64.sha256"
                      LogicalName="Aura.GameCaptureHook64.sha256" />
    <GameCaptureHookSource Include="$(MSBuildProjectDirectory)\..\native\Aura.GameCaptureHook\**\*.*" />
    <GameCaptureHookSource Include="$(MSBuildProjectDirectory)\..\..\third_party\minhook\**\*.c" />
    <GameCaptureHookSource Include="$(MSBuildProjectDirectory)\..\..\third_party\minhook\**\*.h" />
    <GameCaptureHookSource Include="$(MSBuildProjectDirectory)\..\..\packaging\build_game_capture_hook.ps1" />
    <GameCaptureHookSource Include="$(MSBuildProjectDirectory)\..\..\packaging\get_zig.ps1" />
  </ItemGroup>

  <Target Name="BuildVerifiedGameCaptureHook"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'Aura'"
          Inputs="@(GameCaptureHookSource)"
          Outputs="$(GameCaptureHookOutput)\Aura.GameCaptureHook64.dll;$(GameCaptureHookOutput)\Aura.GameCaptureHook64.sha256">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\packaging\build_game_capture_hook.ps1&quot; -OutputDir &quot;$(GameCaptureHookOutput)&quot;" />
    <Error Condition="!Exists('$(GameCaptureHookOutput)\Aura.GameCaptureHook64.dll')"
           Text="Native Minecraft capture hook was not produced." />
    <Error Condition="!Exists('$(GameCaptureHookOutput)\Aura.GameCaptureHook64.sha256')"
           Text="Native Minecraft capture hook hash manifest was not produced." />
  </Target>

  <!-- VideoLAN.LibVLC.Windows carries three complete native runtimes. Aura is an
       x64-only application, so publishing x86 and ARM64 adds about 178 MB that can
       never be loaded. Keep every x64 codec/plugin; remove architectures only. -->
  <Target Name="PruneForeignLibVlcRuntimes"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <RemoveDir Directories="$(PublishDir)libvlc\win-x86;$(PublishDir)libvlc\win-arm64" />
  </Target>
</Project>
