<Window x:Class="Aura.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Aura.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Aura" Width="1180" Height="760" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{DynamicResource CanvasBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <!-- Своя шапка: системную рамку убираем, но оставляем ресайз и тень -->
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <c:BoolToVisibility x:Key="Show"/>
        <c:BoolToVisibility x:Key="Hide" Inverted="True"/>
    </Window.Resources>

    <!-- Корень масштабируется целиком: «Размер интерфейса» в настройках -->
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- Фоновое свечение -->
        <Rectangle Fill="{DynamicResource AmbientBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource Ambient2Brush}" IsHitTestVisible="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== БОКОВАЯ КОЛОНКА ==================== -->
            <Border x:Name="Side" Width="236" Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource SepBrush}" BorderThickness="0,0,1,0">
                <DockPanel x:Name="SideContent" Margin="12,14,12,12" LastChildFill="True">

                    <!-- Логотип и название -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,2,14">
                        <!-- Градиент берётся из палитры: у каждой темы он свой -->
                        <Border Width="30" Height="30" CornerRadius="9"
                                Background="{DynamicResource LogoBrush}">
                            <c:Icon Data="{DynamicResource Ico.Aura}" Size="17" Foreground="White"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Aura" FontFamily="{DynamicResource DispFont}" FontSize="16"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}"/>
                    </StackPanel>

                    <!-- Низ колонки: обновление и главный переключатель -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="UpdateCard" Style="{StaticResource RowButton}" Visibility="Collapsed"
                                Margin="0,0,0,8" Click="Update_Click">
                            <Border x:Name="UpdateCardBox" Background="{DynamicResource CardBrush}" CornerRadius="11"
                                    Padding="10,8,10,8" BorderBrush="{DynamicResource SepBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconTile Data="{DynamicResource Ico.Down}" TileSize="20" IconSize="12"
                                                Background="{DynamicResource BlueBrush}"/>
                                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}">
                                        <TextBlock x:Name="UpdateTitle" FontSize="12" FontWeight="SemiBold" Text="Есть обновление"/>
                                        <TextBlock Text="Нажми, чтобы поставить" FontSize="11" Foreground="{DynamicResource Tx2Brush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Button>

                        <Border x:Name="MasterCard" Background="{DynamicResource CardBrush}" CornerRadius="13"
                                Padding="11,10,11,10" BorderBrush="{DynamicResource SepBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"
                                            Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}">
                                    <TextBlock Text="Мгновенный повтор" FontSize="11" Foreground="{DynamicResource Tx2Brush}"/>
                                    <TextBlock x:Name="MasterState" Text="Выключен" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <c:Switch x:Name="MasterSwitch" Grid.Column="1" Click="Master_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Разделы.

                         Подсветка активного раздела — ОДНА плашка на всю колонку, она
                         лежит под пунктами и переезжает между ними. Плашек было две
                         (по одной на группу), и при переходе между группами обе могли
                         остаться видимыми: подсвечивались два раздела разом. -->
                    <Grid x:Name="NavArea" DockPanel.Dock="Top">
                        <Border x:Name="Indicator" Height="34" CornerRadius="9" VerticalAlignment="Top"
                                Background="{DynamicResource PressBrush}" Opacity="0">
                            <Border.RenderTransform><TranslateTransform x:Name="IndicatorShift"/></Border.RenderTransform>
                        </Border>

                        <StackPanel>
                        <TextBlock Text="Главное" Style="{StaticResource Caption3}" Margin="8,11,8,5"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}"/>
                        <Border Height="1" Background="{DynamicResource SepBrush}" Margin="8,10,8,9"
                                Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Show}}"/>

                        <Grid>
                            <StackPanel x:Name="Nav1">
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="overview" IsChecked="True" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconTile Data="{DynamicResource Ico.Gauge}" Background="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Обзор" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                                                   FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="clips" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconTile Data="{DynamicResource Ico.Film}" Background="{DynamicResource BlueBrush}"/>
                                        <TextBlock Text="Клипы" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                                                   FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Настройка" Style="{StaticResource Caption3}" Margin="8,13,8,5"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}"/>
                        <Border Height="1" Background="{DynamicResource SepBrush}" Margin="8,10,8,9"
                                Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Show}}"/>

                        <Grid>
                            <StackPanel x:Name="Nav2">
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="capture" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconTile Data="{DynamicResource Ico.Sliders}" Background="{DynamicResource PurpleBrush}"/>
                                        <TextBlock Text="Захват" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                                                   FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="keys" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconTile Data="{DynamicResource Ico.Keyboard}" Background="{DynamicResource TealBrush}"/>
                                        <TextBlock Text="Клавиши" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                                                   FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="files" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconTile Data="{DynamicResource Ico.Folder}" Background="{DynamicResource OrangeBrush}"/>
                                        <TextBlock Text="Файлы" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                                                   FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="app" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconTile Data="{DynamicResource Ico.App}" Background="{DynamicResource GrayBrush}"/>
                                        <TextBlock Text="Приложение" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                                                   FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="system" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconTile Data="{DynamicResource Ico.Cpu}" Background="{DynamicResource IndigoBrush}"/>
                                        <TextBlock Text="Система" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                                                   FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hide}}"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- заполнитель, чтобы DockPanel растянул колонку -->
                    <Grid/>
                </DockPanel>
            </Border>

            <!-- ==================== ПРАВАЯ ЧАСТЬ ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка: заголовок появляется, когда крупный уехал за край -->
                <Border x:Name="Toolbar" Background="{DynamicResource GlassBrush}"
                        BorderBrush="Transparent" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Toolbar_Drag">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ToolTitle" Margin="24,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource DispFont}" FontSize="14.5" FontWeight="SemiBold"
                                   Opacity="0"/>

                        <StackPanel x:Name="ToolActions" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Свернуть">
                                <c:Icon Data="{DynamicResource Ico.Min}" Size="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Развернуть">
                                <c:Icon Data="{DynamicResource Ico.Max}" Size="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Свернуть в трей">
                                <c:Icon Data="{DynamicResource Ico.X}" Size="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Страница -->
                <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" ScrollChanged="Scroll_Changed"
                              Padding="0">
                    <ContentControl x:Name="PageHost" HorizontalAlignment="Stretch">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="PageShift"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </ScrollViewer>

                <!-- Панель несохранённых изменений: висит над содержимым, а не в конце
                     страницы — прокручивать до неё не нужно. -->
                <Border x:Name="ApplyBar" Grid.Row="1" Height="46" CornerRadius="23"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                        Padding="18,0,6,0" Background="{DynamicResource GlassBrush}"
                        BorderBrush="{DynamicResource HairBrush}" BorderThickness="1"
                        Effect="{DynamicResource ToastShadow}" Opacity="0" Visibility="Collapsed">
                    <Border.RenderTransform><TranslateTransform x:Name="ApplyShift" Y="90"/></Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ApplyText" VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{DynamicResource Tx2Brush}"/>
                        <Button x:Name="ApplyRevert" Content="Отменить" Height="34" Margin="16,0,8,0"
                                Click="ApplyRevert_Click"/>
                        <Button x:Name="ApplyOk" Content="Применить" Height="34"
                                Style="{StaticResource BtnPri}" Click="ApplyOk_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
