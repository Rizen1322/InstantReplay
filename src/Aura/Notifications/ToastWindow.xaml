<Window x:Class="Aura.Notifications.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Aura.Controls"
        Width="400" Height="130"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="Manual" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Уведомление поверх игры: одна карточка постоянной ширины. Слева кадр из
         записи или цветной значок, справа заголовок и подпись, у правого края
         сочетание клавиш, по нижнему краю тонкая полоска времени показа.
         Пока идёт сохранение, в значке крутится индикатор, а когда файл дописан,
         содержимое сменяется на месте: карточка не прыгает по размеру. -->

    <Grid>
        <Border x:Name="Card" Width="340" CornerRadius="14"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                Background="#EB131418" BorderBrush="#1FFFFFFF" BorderThickness="1"
                Effect="{DynamicResource ToastShadow}"
                RenderTransformOrigin="1,1">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="CardShift" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid ClipToBounds="False">
                <Grid x:Name="Body" Margin="10,10,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кадр или значок -->
                    <Border x:Name="Art" Width="36" Height="36" CornerRadius="10" ClipToBounds="True"
                            VerticalAlignment="Center" Background="#2232D74B">
                        <Grid>
                            <Image x:Name="Shot" Stretch="UniformToFill" Opacity="0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <c:Icon x:Name="ArtIcon" Data="{DynamicResource Ico.Save}" Size="18" Foreground="#32D74B"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="Spin" Width="16" Height="16" Stroke="#E8E8ED" StrokeThickness="2"
                                     StrokeDashArray="2.6 1.4" Visibility="Collapsed"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#F2F3F5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubText" FontSize="12" Foreground="#A3A8B2"
                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="HintText" Grid.Column="2" VerticalAlignment="Center"
                               FontFamily="{DynamicResource DispFont}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8A8F99"/>
                </Grid>

                <!-- Полоска времени показа: по нижнему краю карточки, цветом события -->
                <Border x:Name="LifeTrack" Height="2" VerticalAlignment="Bottom" Margin="1,0,1,0"
                        CornerRadius="0,0,13,13" ClipToBounds="True" Opacity="0">
                    <Border x:Name="Life" Background="#32D74B" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="LifeScale" ScaleX="1"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
