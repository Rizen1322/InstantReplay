<Window x:Class="Aura.Notifications.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Aura.Controls"
        Width="460" Height="130"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="Manual" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Уведомление поверх игры.
         Сначала появляется узкая капсула («Сохраняю повтор…»), затем она
         разворачивается в карточку с кадром, весом и кнопкой. Окно всегда
         одного размера — анимируется только карточка внутри, поэтому не
         дёргается позиционирование поверх полноэкранной игры. -->

    <Grid>
        <Border x:Name="Card" Width="250" Height="62" CornerRadius="19" Padding="10"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                Background="{DynamicResource GlassBrush}"
                BorderBrush="{DynamicResource HairBrush}" BorderThickness="1"
                Effect="{DynamicResource ToastShadow}"
                RenderTransformOrigin="1,1">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="CardShift" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Кадр или цветная плитка с иконкой -->
                <Border x:Name="Art" Width="40" Height="40" CornerRadius="13"
                        Background="{DynamicResource AccentBrush}" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="Shot" Stretch="UniformToFill" Opacity="0"/>
                        <c:Icon x:Name="ArtIcon" Data="{DynamicResource Ico.Save}" Size="18" Foreground="White"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- крутящийся индикатор на время сохранения -->
                        <Ellipse x:Name="Spin" Width="17" Height="17" Stroke="White" StrokeThickness="2"
                                 StrokeDashArray="2.6 1.4" Visibility="Collapsed"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinRotate" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TxBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" FontSize="11.5" Foreground="{DynamicResource Tx2Brush}"
                               TextTrimming="CharacterEllipsis" Opacity="0" Margin="0,1,0,0"/>
                </StackPanel>

                <TextBlock x:Name="HintText" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0"
                           FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Tx3Brush}"
                           Opacity="0"/>

                <!-- Полоска времени показа -->
                <Border x:Name="LifeTrack" Grid.ColumnSpan="3" Height="2" CornerRadius="1"
                        VerticalAlignment="Bottom" Margin="2,0,2,-6" Opacity="0"
                        Background="{DynamicResource TrackBrush}">
                    <Border x:Name="Life" Background="{DynamicResource Tx3Brush}" CornerRadius="1"
                            HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="LifeScale" ScaleX="1"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
