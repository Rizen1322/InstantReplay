<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ================= ШРИФТЫ =================
         Обе гарнитуры вшиты в сборку (Fonts/*.ttf): у Golos Text и Onest
         кириллица нарисована, а не растянута из латиницы. -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#Golos Text</FontFamily>
    <FontFamily x:Key="DispFont">pack://application:,,,/Fonts/#Onest</FontFamily>

    <!-- ================= АНИМАЦИЯ =================
         Одна кривая на весь интерфейс: лёгкий «перелёт» в конце. -->
    <BackEase x:Key="Spring" EasingMode="EaseOut" Amplitude="0.32"/>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
    <QuadraticEase x:Key="EaseInOut" EasingMode="EaseInOut"/>
    <Duration x:Key="Fast">0:0:0.18</Duration>
    <Duration x:Key="Normal">0:0:0.32</Duration>

    <!-- ================= ТЕКСТ ================= -->
    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TxBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Крупный заголовок страницы -->
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{DynamicResource DispFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- Подзаголовок под ним -->
    <Style x:Key="Lede" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Tx2Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="520"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <!-- Подпись группы над списком -->
    <Style x:Key="GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Tx2Brush}"/>
        <Setter Property="Margin" Value="4,24,4,8"/>
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="RowSub" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Tx2Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Tx2Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Крупная цифра (буфер, гигабайты, счётчики) -->
    <Style x:Key="Numeral" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{DynamicResource DispFont}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Tx2Brush}"/>
    </Style>

    <Style x:Key="Caption3" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Tx3Brush}"/>
    </Style>

    <!-- Текст по умолчанию для всего приложения -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}"/>

    <!-- ================= ПОВЕРХНОСТИ ================= -->

    <!-- Карточка-контейнер (список строк, плитка статистики) -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SepBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="CardSoft" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <!-- Разделитель между строками списка: с отступом слева, как в iOS -->
    <Style x:Key="RowSeparator" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource SepBrush}"/>
        <Setter Property="Margin" Value="16,0,0,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Строка списка: подпись слева, управление справа -->
    <Style x:Key="Row" TargetType="Grid">
        <Setter Property="Margin" Value="16,12,16,12"/>
    </Style>

    <!-- Плашка-статус: скругление как у всего остального, не овал -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="9,3,9,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Tx2Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Тень окна и всплывающих поверхностей -->
    <DropShadowEffect x:Key="WindowShadow" BlurRadius="42" ShadowDepth="14" Direction="270"
                      Color="{DynamicResource ShadowColor}" Opacity="0.55"/>
    <DropShadowEffect x:Key="ToastShadow" BlurRadius="34" ShadowDepth="10" Direction="270"
                      Color="{DynamicResource ShadowColor}" Opacity="0.5"/>
    <DropShadowEffect x:Key="LiftShadow" BlurRadius="26" ShadowDepth="8" Direction="270"
                      Color="{DynamicResource ShadowColor}" Opacity="0.38"/>

</ResourceDictionary>
