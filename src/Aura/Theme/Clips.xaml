<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Aura.Controls"
                    xmlns:lib="clr-namespace:Aura.Core.Library"
                    xmlns:v="clr-namespace:Aura.Views">

    <!-- Своя копия кривой: StaticResource ищется в пределах этого словаря -->
    <BackEase x:Key="Spring" EasingMode="EaseOut" Amplitude="0.32"/>

    <!-- Кнопка-обёртка карточки: только курсор и клик, никакого фона -->
    <Style x:Key="ClipCardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent"><ContentPresenter/></Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Карточка записи. Пока кадр не загрузился, на её месте лежит спокойная
         заглушка — сетка не «прыгает» и не мигает белым. -->
    <DataTemplate x:Key="ClipCard" DataType="{x:Type lib:ClipItem}">
        <Button Style="{StaticResource ClipCardButton}" Width="196" Margin="0,0,14,16"
                ToolTip="{Binding FileName}"
                c:DragFile.Path="{Binding FullPath}">
            <Button.ContextMenu>
                <ContextMenu Style="{DynamicResource TrayMenu}">
                    <MenuItem Header="Открыть" Style="{DynamicResource TrayMenuItem}"
                              Command="{x:Static v:ClipCommands.Open}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Показать в папке" Style="{DynamicResource TrayMenuItem}"
                              Command="{x:Static v:ClipCommands.Reveal}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Копировать путь" Style="{DynamicResource TrayMenuItem}"
                              Command="{x:Static v:ClipCommands.CopyPath}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Обрезать в LosslessCut" Style="{DynamicResource TrayMenuItem}"
                              Command="{x:Static v:ClipCommands.Trim}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Сжать для Discord" Style="{DynamicResource TrayMenuItem}"
                              Command="{x:Static v:ClipCommands.Compress}" CommandParameter="{Binding}"/>
                    <Separator Margin="8,4,8,4"/>
                    <MenuItem Header="Переименовать" Style="{DynamicResource TrayMenuItem}"
                              Command="{x:Static v:ClipCommands.Rename}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Удалить в корзину" Style="{DynamicResource TrayMenuItem}"
                              Command="{x:Static v:ClipCommands.Delete}" CommandParameter="{Binding}"/>
                </ContextMenu>
            </Button.ContextMenu>
            <StackPanel>
                <Border x:Name="Shot" Height="122" CornerRadius="14" ClipToBounds="True"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ShotScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="ShotShift" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF1E2A2E" Offset="0"/>
                            <GradientStop Color="#FF11171A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <c:Icon Data="{DynamicResource Ico.Film}" Size="24" Opacity="0.35"
                                Foreground="{DynamicResource Tx3Brush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>

                        <!-- затемнение снизу, чтобы плашки читались на любом кадре -->
                        <Border VerticalAlignment="Bottom" Height="52" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#99000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border BorderThickness="1" BorderBrush="#22FFFFFF" CornerRadius="14" IsHitTestVisible="False"/>

                        <!-- «Новое» у только что сохранённых -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="7,2,7,3"
                                Visibility="{Binding NewVisibility}">
                            <TextBlock Text="НОВОЕ" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentInkBrush}"/>
                        </Border>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                Background="#9E000000" CornerRadius="7" Padding="7,2,7,3"
                                Visibility="{Binding DurationVisibility}">
                            <TextBlock Text="{Binding DurationText}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>

                        <!-- кружок Play при наведении -->
                        <Border x:Name="Play" Width="46" Height="46" CornerRadius="23" Opacity="0"
                                Background="#38FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="PlayScale" ScaleX="0.82" ScaleY="0.82"/></Border.RenderTransform>
                            <c:Icon Data="{DynamicResource Ico.Play}" Size="16" Filled="True" Foreground="White"
                                    Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="2,9,2,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Margin="2,1,2,0"
                           Foreground="{DynamicResource Tx2Brush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Button>

        <DataTemplate.Triggers>
            <Trigger SourceName="Shot" Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ShotShift" Storyboard.TargetProperty="Y"
                                             To="-5" Duration="0:0:0.28" EasingFunction="{StaticResource Spring}"/>
                            <DoubleAnimation Storyboard.TargetName="ShotScale" Storyboard.TargetProperty="ScaleX"
                                             To="1.02" Duration="0:0:0.28" EasingFunction="{StaticResource Spring}"/>
                            <DoubleAnimation Storyboard.TargetName="ShotScale" Storyboard.TargetProperty="ScaleY"
                                             To="1.02" Duration="0:0:0.28" EasingFunction="{StaticResource Spring}"/>
                            <DoubleAnimation Storyboard.TargetName="Play" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.3" EasingFunction="{StaticResource Spring}"/>
                            <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.3" EasingFunction="{StaticResource Spring}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ShotShift" Storyboard.TargetProperty="Y"
                                             To="0" Duration="0:0:0.28"/>
                            <DoubleAnimation Storyboard.TargetName="ShotScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.28"/>
                            <DoubleAnimation Storyboard.TargetName="ShotScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.28"/>
                            <DoubleAnimation Storyboard.TargetName="Play" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX"
                                             To="0.82" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY"
                                             To="0.82" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Сетка карточек с переносом -->
    <ItemsPanelTemplate x:Key="ClipGridPanel">
        <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

</ResourceDictionary>
