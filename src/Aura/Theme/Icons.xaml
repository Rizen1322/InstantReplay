    <!-- ============================================================
         Второй набор: действия в меню и на кнопках.
         Раньше иконку получала только часть кнопок — соседние строки
         выглядели как разные приложения. Эти контуры закрывают все
         действия, которые есть в интерфейсе, в той же манере 24×24.
         ============================================================ -->

    <!-- переименовать -->
    <GeometryGroup x:Key="Ico.Pencil">
        <PathGeometry Figures="M4.4 19.6l.8-4 11-11a2.2 2.2 0 0 1 3.2 3.2l-11 11z"/>
        <PathGeometry Figures="M14.6 6.2l3.2 3.2"/>
    </GeometryGroup>

    <!-- копировать -->
    <GeometryGroup x:Key="Ico.Copy">
        <RectangleGeometry Rect="9,9,11,11" RadiusX="2.4" RadiusY="2.4"/>
        <PathGeometry Figures="M5.6 15h-.4A1.7 1.7 0 0 1 3.5 13.3V5.2A1.7 1.7 0 0 1 5.2 3.5h8.1A1.7 1.7 0 0 1 15 5.2v.4"/>
    </GeometryGroup>

