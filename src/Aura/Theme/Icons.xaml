        <PathGeometry Figures="M3.4 7.7 12 3.4l8.6 4.3v8.6L12 20.6 3.4 16.3z"/>
        <PathGeometry Figures="M3.4 7.7 12 12l8.6-4.3 M12 12v8.6"/>
