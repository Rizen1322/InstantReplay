<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ТЁМНАЯ ТЕМА.
         Ключи здесь, в Palette.Light.xaml и в Palette.Deep.xaml совпадают один
         в один: тема меняется подменой словаря на лету, а все стили ссылаются
         через DynamicResource. -->

    <!-- Типографика живёт в палитре: у темы может быть своя пара гарнитур -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#Golos Text</FontFamily>
    <FontFamily x:Key="DispFont">pack://application:,,,/Fonts/#Onest</FontFamily>

    <Color x:Key="CanvasColor">#FF0B0B0E</Color>
    <Color x:Key="GlassColor">#F21C1D22</Color>
    <Color x:Key="CardColor">#0EFFFFFF</Color>
    <Color x:Key="Card2Color">#16FFFFFF</Color>
    <Color x:Key="SepColor">#17FFFFFF</Color>
    <Color x:Key="HairColor">#1FFFFFFF</Color>
    <Color x:Key="HoverColor">#14FFFFFF</Color>
    <Color x:Key="PressColor">#22FFFFFF</Color>
    <Color x:Key="TrackColor">#3A8E939C</Color>

    <Color x:Key="TxColor">#FFF3F4F6</Color>
    <Color x:Key="Tx2Color">#FF9DA2AC</Color>
    <Color x:Key="Tx3Color">#FF6E737D</Color>

    <Color x:Key="AccentColor">#FF32D74B</Color>
    <Color x:Key="AccentTxColor">#FF3DDC5C</Color>
    <Color x:Key="AccentInkColor">#FF062A0E</Color>
    <Color x:Key="AccentSoftColor">#2432D74B</Color>

    <Color x:Key="RecColor">#FFFF453A</Color>
    <Color x:Key="BlueColor">#FF0A84FF</Color>
    <Color x:Key="IndigoColor">#FF5E5CE6</Color>
    <Color x:Key="PurpleColor">#FFBF5AF2</Color>
    <Color x:Key="OrangeColor">#FFFF9F0A</Color>
    <!-- Подложка предупреждений: тот же оранжевый, но приглушённый до фона -->
    <Color x:Key="WarnSoftColor">#26FF9F0A</Color>
    <Color x:Key="TealColor">#FF40C8E0</Color>
    <Color x:Key="GrayColor">#FF8E8E93</Color>
    <Color x:Key="PinkColor">#FFFF375F</Color>
    <Color x:Key="KnobColor">#FFFFFFFF</Color>
    <Color x:Key="ShadowColor">#FF000000</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}"/>
    <SolidColorBrush x:Key="GlassBrush" Color="{DynamicResource GlassColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="Card2Brush" Color="{DynamicResource Card2Color}"/>
    <SolidColorBrush x:Key="SepBrush" Color="{DynamicResource SepColor}"/>
    <SolidColorBrush x:Key="HairBrush" Color="{DynamicResource HairColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}"/>
    <SolidColorBrush x:Key="PressBrush" Color="{DynamicResource PressColor}"/>
    <SolidColorBrush x:Key="TrackBrush" Color="{DynamicResource TrackColor}"/>

    <SolidColorBrush x:Key="TxBrush" Color="{DynamicResource TxColor}"/>
    <SolidColorBrush x:Key="Tx2Brush" Color="{DynamicResource Tx2Color}"/>
    <SolidColorBrush x:Key="Tx3Brush" Color="{DynamicResource Tx3Color}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentTxBrush" Color="{DynamicResource AccentTxColor}"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="{DynamicResource AccentInkColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}"/>

    <SolidColorBrush x:Key="RecBrush" Color="{DynamicResource RecColor}"/>
    <SolidColorBrush x:Key="BlueBrush" Color="{DynamicResource BlueColor}"/>
    <SolidColorBrush x:Key="IndigoBrush" Color="{DynamicResource IndigoColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{DynamicResource PurpleColor}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="{DynamicResource OrangeColor}"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{DynamicResource WarnSoftColor}"/>
    <SolidColorBrush x:Key="TealBrush" Color="{DynamicResource TealColor}"/>
    <SolidColorBrush x:Key="GrayBrush" Color="{DynamicResource GrayColor}"/>
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}"/>
    <SolidColorBrush x:Key="KnobBrush" Color="{DynamicResource KnobColor}"/>

    <!-- Крупные градиентные поверхности. В обычной тёмной теме градиента нет:
         это плоская карточка и фирменная зелёная плитка логотипа. -->
    <SolidColorBrush x:Key="HeroBrush" Color="{DynamicResource CardColor}"/>
    <!-- Карточка плоская — «поверх градиента» рисовать нечем, цвета обычные -->
    <SolidColorBrush x:Key="HeroTxBrush" Color="{DynamicResource TxColor}"/>
    <SolidColorBrush x:Key="HeroTx2Brush" Color="{DynamicResource Tx2Color}"/>
    <SolidColorBrush x:Key="HeroTx3Brush" Color="{DynamicResource Tx3Color}"/>
    <SolidColorBrush x:Key="HeroTrackBrush" Color="{DynamicResource TrackColor}"/>
    <SolidColorBrush x:Key="HeroFillBrush" Color="{DynamicResource AccentColor}"/>
    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#FF5CF07C" Offset="0"/>
        <GradientStop Color="#FF12A53C" Offset="0.62"/>
        <GradientStop Color="#FF0B8C6E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Фоновое свечение окна: зелёное сверху слева, синее снизу справа -->
    <RadialGradientBrush x:Key="AmbientBrush" GradientOrigin="0.12,0" Center="0.12,0"
                         RadiusX="0.85" RadiusY="0.75">
        <GradientStop Color="#1A32D74B" Offset="0"/>
        <GradientStop Color="#0032D74B" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Ambient2Brush" GradientOrigin="0.95,0.08" Center="0.95,0.08"
                         RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#1F5E5CE6" Offset="0"/>
        <GradientStop Color="#005E5CE6" Offset="1"/>
    </RadialGradientBrush>

</ResourceDictionary>
