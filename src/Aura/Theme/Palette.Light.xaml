<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- СВЕТЛАЯ ТЕМА. Не инверсия тёмной: карточки белые и держатся тенью,
         разделители тонкие тёмные, зелёный темнее — иначе он «горит» на белом. -->

    <Color x:Key="CanvasColor">#FFF4F4F6</Color>
    <Color x:Key="GlassColor">#F5FAFAFC</Color>
    <Color x:Key="CardColor">#FFFFFFFF</Color>
    <Color x:Key="Card2Color">#FFFFFFFF</Color>
    <Color x:Key="SepColor">#14000000</Color>
    <Color x:Key="HairColor">#1A000000</Color>
    <Color x:Key="HoverColor">#0D000000</Color>
    <Color x:Key="PressColor">#18000000</Color>
    <Color x:Key="TrackColor">#4A8E939C</Color>

    <Color x:Key="TxColor">#FF1A1A1E</Color>
    <Color x:Key="Tx2Color">#FF6B6F76</Color>
    <Color x:Key="Tx3Color">#FF93979E</Color>

    <Color x:Key="AccentColor">#FF34C759</Color>
    <Color x:Key="AccentTxColor">#FF1C8F3A</Color>
    <Color x:Key="AccentInkColor">#FFFFFFFF</Color>
    <Color x:Key="AccentSoftColor">#2434C759</Color>

    <Color x:Key="RecColor">#FFE0352B</Color>
    <Color x:Key="BlueColor">#FF0071E3</Color>
    <Color x:Key="IndigoColor">#FF5856D6</Color>
    <Color x:Key="PurpleColor">#FFAF52DE</Color>
    <Color x:Key="OrangeColor">#FFF08C00</Color>
    <!-- Подложка предупреждений: тот же оранжевый, но приглушённый до фона -->
    <Color x:Key="WarnSoftColor">#22F08C00</Color>
    <Color x:Key="TealColor">#FF2AA3BF</Color>
    <Color x:Key="GrayColor">#FF8A8A8E</Color>
    <Color x:Key="PinkColor">#FFF02D51</Color>
    <Color x:Key="KnobColor">#FFFFFFFF</Color>
    <Color x:Key="ShadowColor">#FF141A20</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}"/>
    <SolidColorBrush x:Key="GlassBrush" Color="{DynamicResource GlassColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="Card2Brush" Color="{DynamicResource Card2Color}"/>
    <SolidColorBrush x:Key="SepBrush" Color="{DynamicResource SepColor}"/>
    <SolidColorBrush x:Key="HairBrush" Color="{DynamicResource HairColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}"/>
    <SolidColorBrush x:Key="PressBrush" Color="{DynamicResource PressColor}"/>
    <SolidColorBrush x:Key="TrackBrush" Color="{DynamicResource TrackColor}"/>

    <SolidColorBrush x:Key="TxBrush" Color="{DynamicResource TxColor}"/>
    <SolidColorBrush x:Key="Tx2Brush" Color="{DynamicResource Tx2Color}"/>
    <SolidColorBrush x:Key="Tx3Brush" Color="{DynamicResource Tx3Color}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentTxBrush" Color="{DynamicResource AccentTxColor}"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="{DynamicResource AccentInkColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}"/>

    <SolidColorBrush x:Key="RecBrush" Color="{DynamicResource RecColor}"/>
    <SolidColorBrush x:Key="BlueBrush" Color="{DynamicResource BlueColor}"/>
    <SolidColorBrush x:Key="IndigoBrush" Color="{DynamicResource IndigoColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{DynamicResource PurpleColor}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="{DynamicResource OrangeColor}"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{DynamicResource WarnSoftColor}"/>
    <SolidColorBrush x:Key="TealBrush" Color="{DynamicResource TealColor}"/>
    <SolidColorBrush x:Key="GrayBrush" Color="{DynamicResource GrayColor}"/>
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource PinkColor}"/>
    <SolidColorBrush x:Key="KnobBrush" Color="{DynamicResource KnobColor}"/>

    <RadialGradientBrush x:Key="AmbientBrush" GradientOrigin="0.12,0" Center="0.12,0"
                         RadiusX="0.85" RadiusY="0.75">
        <GradientStop Color="#2134C759" Offset="0"/>
        <GradientStop Color="#0034C759" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Ambient2Brush" GradientOrigin="0.95,0.08" Center="0.95,0.08"
                         RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#1A5856D6" Offset="0"/>
        <GradientStop Color="#005856D6" Offset="1"/>
    </RadialGradientBrush>

</ResourceDictionary>
