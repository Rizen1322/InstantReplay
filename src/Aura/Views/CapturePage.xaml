<views:PageBase x:Class="Aura.Views.CapturePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:Aura.Controls"
                xmlns:views="clr-namespace:Aura.Views">

    <Grid>
        <Grid MaxWidth="840" Margin="28,24,28,80" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="Захват" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Качество картинки, длина повтора и звук." Style="{StaticResource Lede}"/>

                <!-- ==================== ПРЕСЕТЫ ==================== -->
                <TextBlock Text="Готовые наборы" Style="{StaticResource GroupLabel}" Margin="4,0,4,8"/>
                <UniformGrid x:Name="Presets" Rows="1" Columns="4"/>

                <!-- ==================== КАЧЕСТВО ==================== -->
                <TextBlock Text="Качество" Style="{StaticResource GroupLabel}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <TextBlock Text="Разрешение" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                            <c:Segmented x:Name="ResolutionSeg" HorizontalAlignment="Right"
                                         SelectionChanged="VideoSelection_Changed">
                                <ListBoxItem Content="720p" Tag="720"/>
                                <ListBoxItem Content="1080p" Tag="1080"/>
                                <ListBoxItem Content="1440p" Tag="1440"/>
                                <ListBoxItem Content="4K" Tag="2160"/>
                            </c:Segmented>
                        </c:AdaptiveRow>

                        <Border Style="{StaticResource RowSeparator}"/>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <TextBlock Text="Кадров в секунду" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                            <c:Segmented x:Name="FpsSeg" HorizontalAlignment="Right" SelectionChanged="VideoSelection_Changed">
                                <ListBoxItem Content="30" Tag="30"/>
                                <ListBoxItem Content="60" Tag="60"/>
                                <ListBoxItem Content="120" Tag="120"/>
                                <ListBoxItem Content="144" Tag="144"/>
                            </c:Segmented>
                        </c:AdaptiveRow>

                        <Border Style="{StaticResource RowSeparator}"/>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Битрейт" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="BitrateSub" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="BitrateValue" Style="{StaticResource RowValue}" Width="76"
                                           TextAlignment="Right" Margin="0,0,10,0"/>
                                <Slider x:Name="Bitrate" Minimum="10" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </StackPanel>
                        </c:AdaptiveRow>
                    </StackPanel>
                </Border>

                <!-- ==================== КОДЕК ==================== -->
                <TextBlock Text="Кодек" Style="{StaticResource GroupLabel}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="Codecs"/>
                </Border>

                <!-- ==================== ДЛИНА ПОВТОРА ==================== -->
                <Grid>
                    <TextBlock Text="Длина повтора" Style="{StaticResource GroupLabel}"/>
                    <TextBlock Text="длинный повтор занимает больше памяти" Style="{StaticResource Caption3}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,10"/>
                </Grid>
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="16,13,16,13">
                        <WrapPanel x:Name="Lengths"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Своё значение" Style="{StaticResource RowValue}" Margin="0,0,10,0"/>
                            <TextBox x:Name="CustomLength" Width="76" TextAlignment="Center"
                                     PreviewTextInput="Digits_Only" LostFocus="CustomLength_Commit"
                                     KeyDown="CustomLength_Key"/>
                            <TextBlock Text="сек" Style="{StaticResource RowValue}" Margin="8,0,0,0"/>
                            <Border Style="{StaticResource Pill}" Margin="14,0,0,0">
                                <TextBlock x:Name="RamEstimate" Style="{StaticResource PillText}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== ЗВУК ==================== -->
                <TextBlock Text="Звук" Style="{StaticResource GroupLabel}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <c:IconTile Data="{DynamicResource Ico.Speaker}" Background="{DynamicResource PinkBrush}"/>
                            <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Звук игры" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="GameDeviceName" Style="{StaticResource RowSub}"/>
                                <Grid Margin="0,7,0,0" HorizontalAlignment="Left" Width="172">
                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
                                    <Border x:Name="GameLevel" Height="4" CornerRadius="2" Width="0"
                                            HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"/>
                                </Grid>
                            </StackPanel>
                            <c:Switch x:Name="GameAudio" Click="Audio_Changed"/>
                        </c:AdaptiveRow>

                        <Border Style="{StaticResource RowSeparator}" Margin="52,0,0,0"/>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <c:IconTile Data="{DynamicResource Ico.Mic}" Background="{DynamicResource IndigoBrush}"/>
                            <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Микрофон" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="MicDeviceName" Style="{StaticResource RowSub}"/>
                                <Grid Margin="0,7,0,0" HorizontalAlignment="Left" Width="172">
                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
                                    <Border x:Name="MicLevel" Height="4" CornerRadius="2" Width="0"
                                            HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"/>
                                </Grid>
                            </StackPanel>
                            <c:Switch x:Name="MicAudio" Click="Audio_Changed"/>
                        </c:AdaptiveRow>

                        <Border Style="{StaticResource RowSeparator}"/>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Дорожки в файле" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Раздельные удобны для монтажа: голос можно убрать или свести заново"
                                           Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <ComboBox x:Name="TrackMode" MinWidth="190" SelectionChanged="AudioSelection_Changed">
                                <ComboBoxItem Content="Одна дорожка" Tag="Mixed"/>
                                <ComboBoxItem Content="Две отдельные" Tag="Separate"/>
                                <ComboBoxItem Content="Только игра" Tag="GameOnly"/>
                                <ComboBoxItem Content="Только микрофон" Tag="MicOnly"/>
                            </ComboBox>
                        </c:AdaptiveRow>

                        <Border Style="{StaticResource RowSeparator}"/>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Шумодав микрофона" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Убирает фоновый гул в паузах между фразами" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <c:Switch x:Name="NoiseGate" Click="NoiseGate_Changed"/>
                        </c:AdaptiveRow>

                        <Border x:Name="GateRowSeparator" Style="{StaticResource RowSeparator}"/>
                        <c:AdaptiveRow x:Name="GateRow" Margin="16,12,16,12">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Порог шумодава" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Тише этого уровня микрофон молчит" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="GateValue" Style="{StaticResource RowValue}" Width="60"
                                           TextAlignment="Right" Margin="0,0,10,0"/>
                                <Slider x:Name="Gate" Minimum="-70" Maximum="-20" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </StackPanel>
                        </c:AdaptiveRow>

                        <Border Style="{StaticResource RowSeparator}"/>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <TextBlock Text="Откуда брать звук игры" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="RenderDevice" MinWidth="230" SelectionChanged="AudioSelection_Changed"/>
                        </c:AdaptiveRow>

                        <Border Style="{StaticResource RowSeparator}"/>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <TextBlock Text="Какой микрофон писать" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CaptureDevice" MinWidth="230" SelectionChanged="AudioSelection_Changed"/>
                        </c:AdaptiveRow>
                    </StackPanel>
                </Border>

                <!-- ==================== ЧТО ЗАПИСЫВАТЬ ==================== -->
                <TextBlock Text="Что записывать" Style="{StaticResource GroupLabel}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <TextBlock Text="Экран" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="Monitor" MinWidth="230" SelectionChanged="VideoSelection_Changed"/>
                        </c:AdaptiveRow>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Курсор мыши" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="В шутерах обычно не нужен" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <c:Switch x:Name="CursorSwitch" Click="Video_Changed"/>
                        </c:AdaptiveRow>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

    </Grid>
</views:PageBase>
