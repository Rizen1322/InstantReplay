<views:PageBase x:Class="Aura.Views.CapturePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:Aura.Controls"
                xmlns:views="clr-namespace:Aura.Views">

    <!-- Видео: список настроек слева прокручивается, панель справа показывает,
         во что обходятся выбранные значения, и стоит на месте. -->
    <Grid Margin="20,16,16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="AsideCol" Width="300"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel Margin="0,0,0,90">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                    <TextBlock Text="Видео" Style="{StaticResource PageTitle}" Margin="0"/>
                    <TextBlock Text="Качество картинки и длина повтора" Style="{StaticResource Lede}"
                               Margin="12,0,0,5" VerticalAlignment="Bottom"/>
                </StackPanel>

                <!-- ==================== ПРЕСЕТЫ ==================== -->
                <TextBlock Text="Готовые наборы" Style="{StaticResource GroupLabel}" Margin="4,4,4,7"/>
                <UniformGrid x:Name="Presets" Rows="1" Columns="4" Margin="0,0,-8,0"/>

                <!-- ==================== КАЧЕСТВО ==================== -->
                <TextBlock Text="Качество" Style="{StaticResource GroupLabel}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <TextBlock Text="Разрешение" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                            <c:Segmented x:Name="ResolutionSeg" HorizontalAlignment="Right"
                                         SelectionChanged="VideoSelection_Changed">
                                <ListBoxItem Content="720p" Tag="720"/>
                                <ListBoxItem Content="1080p" Tag="1080"/>
                                <ListBoxItem Content="1440p" Tag="1440"/>
                                <ListBoxItem Content="4K" Tag="2160"/>
                            </c:Segmented>
                        </c:AdaptiveRow>

                        <c:AdaptiveRow Margin="16,12,16,12">
                            <TextBlock Text="Кадров в секунду" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                            <c:Segmented x:Name="FpsSeg" HorizontalAlignment="Right" SelectionChanged="VideoSelection_Changed">
                                <ListBoxItem Content="30" Tag="30"/>
                                <ListBoxItem Content="60" Tag="60"/>
                                <ListBoxItem Content="120" Tag="120"/>
                                <ListBoxItem Content="144" Tag="144"/>
                            </c:Segmented>
                        </c:AdaptiveRow>

                        <c:AdaptiveRow Margin="16,12,16,12">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Битрейт" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="BitrateSub" Text="Выше битрейт: чётче в динамике, но тяжелее файл"
                                           Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="Bitrate" Minimum="4" Maximum="150" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Width="180"/>
                                <TextBlock x:Name="BitrateValue" Style="{StaticResource RowValue}" Width="84"
                                           TextAlignment="Right" FontFamily="{DynamicResource DispFont}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TxBrush}"/>
                            </StackPanel>
                        </c:AdaptiveRow>

                        <!-- Кодек: три плитки -->
                        <UniformGrid x:Name="Codecs" Rows="1" Columns="3" Margin="10,4,2,10"/>

                        <c:AdaptiveRow Margin="16,12,16,12">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Десять бит цвета" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="TenBitSub" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <c:Switch x:Name="TenBitSwitch" Click="Video_Changed"/>
                        </c:AdaptiveRow>
                    </StackPanel>
                </Border>

                <!-- ==================== ПОВТОР ==================== -->
                <TextBlock Text="Повтор" Style="{StaticResource GroupLabel}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Margin="16,13,16,8">
                            <TextBlock Text="Длина повтора" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="Длинный повтор занимает больше памяти или места на диске" Style="{StaticResource RowSub}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <WrapPanel x:Name="Lengths"/>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,6" VerticalAlignment="Top">
                                    <TextBox x:Name="CustomLength" Width="64" Height="30" TextAlignment="Center"
                                             FontFamily="{DynamicResource DispFont}" FontWeight="SemiBold"
                                             PreviewTextInput="Digits_Only" LostFocus="CustomLength_Commit"
                                             KeyDown="CustomLength_Key" ToolTip="Своё значение в секундах"/>
                                    <TextBlock Text="сек" Style="{StaticResource RowValue}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                        <c:AdaptiveRow Margin="16,6,16,13">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Буфер на диске" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Для длинного повтора: память почти не занимает, но диск пишется постоянно"
                                           Style="{StaticResource RowSub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <c:Switch x:Name="DiskBufferSwitch" Click="DiskBuffer_Changed"/>
                        </c:AdaptiveRow>
                    </StackPanel>
                </Border>

                <!-- ==================== ЧТО ЗАПИСЫВАТЬ ==================== -->
                <TextBlock Text="Что записывать" Style="{StaticResource GroupLabel}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Экран" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Игра на весь экран пишется с этого монитора" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <ComboBox x:Name="Monitor" MinWidth="240" SelectionChanged="VideoSelection_Changed"/>
                        </c:AdaptiveRow>
                        <c:AdaptiveRow Margin="16,12,16,12">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Курсор мыши" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="CursorSub" Text="В шутерах обычно не нужен" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <c:Switch x:Name="CursorSwitch" Click="Video_Changed"/>
                        </c:AdaptiveRow>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== ВО ЧТО ОБОЙДЁТСЯ ==================== -->
        <StackPanel x:Name="Aside" Grid.Column="1" Margin="2,0,0,0">
            <Border Style="{StaticResource AsidePanel}">
                <StackPanel>
                    <TextBlock Text="Во что это обойдётся" Style="{StaticResource AsideTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="EstBig" Style="{StaticResource BigNum}" Text="0 МБ"/>
                        <TextBlock x:Name="EstWhere" Text="в памяти" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Tx3Brush}" VerticalAlignment="Bottom" Margin="8,0,0,6"/>
                    </StackPanel>
                    <TextBlock x:Name="RamEstimate" Style="{StaticResource AsideNote}" Margin="0,8,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Кодирует" Style="{StaticResource KvKey}"/>
                        <TextBlock x:Name="KvEncoder" Grid.Column="1" Style="{StaticResource KvVal}"/>
                        <TextBlock Grid.Row="1" Text="Минута записи" Style="{StaticResource KvKey}"/>
                        <TextBlock x:Name="KvMinute" Grid.Row="1" Grid.Column="1" Style="{StaticResource KvVal}"/>
                        <TextBlock Grid.Row="2" Text="Файл повтора" Style="{StaticResource KvKey}"/>
                        <TextBlock x:Name="KvClip" Grid.Row="2" Grid.Column="1" Style="{StaticResource KvVal}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</views:PageBase>
