<Window x:Class="Aura.Views.ClipEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Aura.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Редактор Aura" Width="1020" Height="720" MinWidth="760" MinHeight="590"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Rectangle Fill="{DynamicResource AmbientBrush}" IsHitTestVisible="False"/>
        <Grid Margin="22,14,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Своя шапка сохраняет единый вид Aura и оставляет нормальный resize. -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Встроенный редактор" FontFamily="{DynamicResource DispFont}"
                               FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FileNameText" Foreground="{DynamicResource Tx2Brush}"
                               FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Width="34" Height="34" Padding="0" Click="Close_Click"
                        ToolTip="Закрыть (Esc)">
                    <c:Icon Data="{DynamicResource Ico.X}" Size="15"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#FF070A0C" BorderBrush="{DynamicResource HairBrush}"
                        BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                    <Grid>
                        <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      Stretch="Uniform" ScrubbingEnabled="True"
                                      MediaOpened="Preview_MediaOpened" MediaFailed="Preview_MediaFailed"/>
                        <Border VerticalAlignment="Bottom" Height="50" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#B8000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="PreviewTime" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,16,12" Foreground="White" FontWeight="SemiBold"
                                   Text="00:00.000 / 00:00.000"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="2,14,2,0">
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" ValueChanged="SeekSlider_ValueChanged"
                            IsMoveToPointEnabled="True" ToolTip="Позиция воспроизведения"/>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StartTimeText" Text="IN  00:00.000" Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectionTimeText" Grid.Column="1" Text="фрагмент 00:00.000"
                                   Foreground="{DynamicResource Tx2Brush}"/>
                        <TextBlock x:Name="EndTimeText" Grid.Column="2" Text="OUT  00:00.000"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Slider x:Name="StartSlider" Minimum="0" Maximum="1" ValueChanged="StartSlider_ValueChanged"
                                IsMoveToPointEnabled="True" ToolTip="Начало фрагмента (I)"/>
                        <Slider x:Name="EndSlider" Grid.Row="1" Minimum="0" Maximum="1" Value="1"
                                ValueChanged="EndSlider_ValueChanged" IsMoveToPointEnabled="True"
                                ToolTip="Конец фрагмента (O)"/>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,13,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PlayButton" Width="88" Content="▶  Играть" Click="Play_Click"/>
                        <Button Content="− кадр" Margin="8,0,0,0" Click="PreviousFrame_Click"/>
                        <Button Content="+ кадр" Margin="8,0,0,0" Click="NextFrame_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="IN" Width="58" ToolTip="Поставить начало здесь (I)" Click="SetIn_Click"/>
                        <Button Content="OUT" Width="58" Margin="8,0,0,0"
                                ToolTip="Поставить конец здесь (O)" Click="SetOut_Click"/>
                        <Button Content="Сбросить" Margin="8,0,0,0" Click="Reset_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ExportStatus" Text="Готово к экспорту" Style="{StaticResource RowLabel}"/>
                        <TextBlock x:Name="ExportHint" Text="Точный режим работает встроенными средствами Windows."
                                   Style="{StaticResource RowSub}" Margin="0,3,12,0"/>
                        <ProgressBar x:Name="ExportProgress" Height="4" Margin="0,9,14,0"
                                     Minimum="0" Maximum="1" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CancelExportButton" Content="Отменить" Click="CancelExport_Click"
                                Visibility="Collapsed" Margin="0,0,8,0"/>
                        <Button x:Name="LosslessButton" Content="Без потери" Click="Lossless_Click"
                                Margin="0,0,8,0" ToolTip="Очень быстро; границы по ключевым кадрам"/>
                        <Button x:Name="PreciseButton" Content="Сохранить точно" Style="{StaticResource BtnPri}"
                                Click="Precise_Click" ToolTip="Точные границы; видео будет перекодировано"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
