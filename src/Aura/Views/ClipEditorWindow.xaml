<Window x:Class="Aura.Views.ClipEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Aura.Controls"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Редактор Aura" Width="1100" Height="760" MinWidth="820" MinHeight="640"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True"
        KeyDown="Window_KeyDown">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TimelineHandle" TargetType="{x:Type primitives:Thumb}">
            <Setter Property="Width" Value="18"/><Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="{x:Type primitives:Thumb}">
                    <Grid>
                        <Border Width="18" Background="{DynamicResource AccentBrush}" CornerRadius="5"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="1" Height="13" Fill="#BFFFFFFF"/>
                            <Rectangle Width="1" Height="13" Fill="#BFFFFFFF" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Rectangle Fill="{DynamicResource AmbientBrush}" IsHitTestVisible="False"/>
        <Grid Margin="20,12,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Редактор клипа" FontFamily="{DynamicResource DispFont}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FileNameText" Foreground="{DynamicResource Tx2Brush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Space — пауза   I / O — границы   ← / → — кадр"
                           VerticalAlignment="Center" Margin="16,0,18,0" Foreground="{DynamicResource Tx3Brush}" FontSize="11.5"/>
                <Button Grid.Column="2" Width="34" Height="34" Padding="0" Click="Close_Click" ToolTip="Закрыть (Esc)">
                    <c:Icon Data="{DynamicResource Ico.X}" Size="15"/>
                </Button>
            </Grid>

            <!-- LibVLC и кодеки поставляются вместе с Aura: Windows Media Player не нужен. -->
            <Border Grid.Row="1" Background="#FF030607" BorderBrush="{DynamicResource HairBrush}"
                    BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                <Grid>
                    <vlc:VideoView x:Name="Preview"/>
                    <StackPanel x:Name="PreviewLoading" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Открываю видео…" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Первый запуск движка может занять пару секунд"
                                   Foreground="{DynamicResource Tx2Brush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="PreviewError" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <c:Icon Data="{DynamicResource Ico.Alert}" Size="30" Foreground="{DynamicResource Tx3Brush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Не удалось показать видео" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock x:Name="PreviewErrorText" Foreground="{DynamicResource Tx2Brush}" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="520" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="− кадр" Click="PreviousFrame_Click"/>
                            <Button x:Name="PlayButton" Content="▶  Играть" Width="100" Margin="8,0"
                                    Style="{StaticResource BtnPri}" Click="Play_Click"/>
                            <Button Content="+ кадр" Click="NextFrame_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="PreviewTime" Grid.Column="1" Text="00:00.000 / 00:00.000"
                                   FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="MuteButton" Content="Звук: вкл" Click="Mute_Click"/>
                            <ComboBox x:Name="AudioBox" Width="190" Height="34" Margin="8,0,0,0"
                                      IsEnabled="False" SelectionChanged="AudioTrack_Changed"
                                      ToolTip="Что слышно в предпросмотре и попадёт в экспорт">
                                <ComboBoxItem Content="Поиск аудиодорожек…"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="2,13,2,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="ВЫБРАННЫЙ ФРАГМЕНТ" Foreground="{DynamicResource Tx3Brush}" FontSize="10.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectionTimeText" Grid.Column="1" Text="00:00.000"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Одна шкала: затемнённое отрезается, зелёное сохраняется. -->
                    <Canvas x:Name="Timeline" Height="54" Margin="0,6,0,0" Background="Transparent"
                            SizeChanged="Timeline_SizeChanged" MouseLeftButtonDown="Timeline_MouseLeftButtonDown">
                        <Border x:Name="TimelineTrack" Height="38" CornerRadius="7" Background="{DynamicResource Card2Brush}"
                                BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" Canvas.Top="8"/>
                        <Border x:Name="DimBefore" Height="38" Background="#8C000000" CornerRadius="7,0,0,7" Canvas.Top="8"/>
                        <Border x:Name="SelectedRange" Height="38" Background="#3545E879"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2" Canvas.Top="8"/>
                        <Border x:Name="DimAfter" Height="38" Background="#8C000000" CornerRadius="0,7,7,0" Canvas.Top="8"/>
                        <Border x:Name="Playhead" Width="3" Height="50" CornerRadius="2" Background="White"
                                Canvas.Top="2" IsHitTestVisible="False"/>
                        <primitives:Thumb x:Name="InHandle" Style="{StaticResource TimelineHandle}" Canvas.Top="4"
                                          DragDelta="InHandle_DragDelta"/>
                        <primitives:Thumb x:Name="OutHandle" Style="{StaticResource TimelineHandle}" Canvas.Top="4"
                                          DragDelta="OutHandle_DragDelta"/>
                    </Canvas>

                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IN  " Foreground="{DynamicResource Tx3Brush}"/>
                            <TextBlock x:Name="StartTimeText" Text="00:00.000" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            <Button Content="поставить" Padding="9,3" Margin="8,-5,0,-5" Click="SetIn_Click"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Сбросить границы" Padding="10,3" Margin="0,-5" Click="Reset_Click"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="поставить" Padding="9,3" Margin="0,-5,8,-5" Click="SetOut_Click"/>
                            <TextBlock Text="OUT  " Foreground="{DynamicResource Tx3Brush}"/>
                            <TextBlock x:Name="EndTimeText" Text="00:00.000" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ExportStatus" Text="Готово к экспорту" Style="{StaticResource RowLabel}"/>
                        <TextBlock x:Name="ExportHint" Text="Точно — кадр в кадр. Без потери — быстро, по ключевым кадрам."
                                   Style="{StaticResource RowSub}" Margin="0,3,12,0"/>
                        <ProgressBar x:Name="ExportProgress" Height="4" Margin="0,9,14,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CancelExportButton" Content="Отменить" Click="CancelExport_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                        <Button x:Name="ExportButton" Content="Экспортировать" MinWidth="150"
                                Style="{StaticResource BtnPri}" Click="Export_Click"
                                ToolTip="Сохранить выбранный фрагмент"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
