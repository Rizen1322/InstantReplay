<Window x:Class="Aura.Views.ClipEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Aura.Controls"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Редактор Aura" Width="1180" Height="800" MinWidth="880" MinHeight="660"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True"
        PreviewKeyDown="Window_KeyDown">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Иконки, которых нет в общем наборе. Тот же квадрат 24×24, что у Icons.xaml. -->
        <PathGeometry x:Key="Ico.Pause" Figures="M7.2 5h3.2v14H7.2z M13.6 5h3.2v14h-3.2z"/>
        <PathGeometry x:Key="Ico.FrameBack" Figures="M14.5 6l-6 6 6 6"/>
        <PathGeometry x:Key="Ico.FrameFwd" Figures="M9.5 6l6 6-6 6"/>
        <PathGeometry x:Key="Ico.ToStart" Figures="M6.5 5.5v13 M18 6l-7 6 7 6"/>
        <PathGeometry x:Key="Ico.ToEnd" Figures="M17.5 5.5v13 M6 6l7 6-7 6"/>
        <PathGeometry x:Key="Ico.SpeakerOff" Figures="M4 9.4h3.4L12 5.6v12.8L7.4 14.6H4z M15.8 9.6l4.8 4.8 M20.6 9.6l-4.8 4.8"/>
        <PathGeometry x:Key="Ico.MarkIn" Figures="M8 5v14 M8 5h5 M8 19h5 M17 12h-5 M14.5 9.5L17 12l-2.5 2.5"/>
        <PathGeometry x:Key="Ico.MarkOut" Figures="M16 5v14 M16 5h-5 M16 19h-5 M7 12h5 M9.5 9.5L7 12l2.5 2.5"/>

        <Style x:Key="TimelineHandle" TargetType="{x:Type primitives:Thumb}">
            <Setter Property="Width" Value="14"/><Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="{x:Type primitives:Thumb}">
                    <Grid Background="Transparent">
                        <Border x:Name="Grip" Width="12" Background="{DynamicResource AccentBrush}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="1.5" Height="14" Fill="#CCFFFFFF" RadiusX="0.75" RadiusY="0.75"/>
                                <Rectangle Width="1.5" Height="14" Fill="#CCFFFFFF" RadiusX="0.75" RadiusY="0.75" Margin="2.5,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Width" Value="14"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Width" Value="14"/>
                            <Setter TargetName="Grip" Property="Effect">
                                <Setter.Value><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.55"
                                                                Color="{DynamicResource AccentColor}"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <!-- Круглая кнопка транспорта: только иконка, подсказка — в ToolTip. -->
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Tx2Brush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Rectangle Fill="{DynamicResource AmbientBrush}" IsHitTestVisible="False"/>
        <Grid Margin="20,10,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <c:IconTile Data="{DynamicResource Ico.Scissors}" Background="{DynamicResource AccentBrush}"
                            TileSize="32" IconSize="17" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Редактор клипа" FontFamily="{DynamicResource DispFont}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FileNameText" Foreground="{DynamicResource Tx2Brush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource BtnSquare}" Width="34" Height="34" Click="Close_Click" ToolTip="Закрыть (Esc)">
                    <c:Icon Data="{DynamicResource Ico.X}" Size="15"/>
                </Button>
            </Grid>

            <!-- ПРЕДПРОСМОТР. LibVLC и кодеки поставляются вместе с Aura. -->
            <Border Grid.Row="1" Background="#FF030607" BorderBrush="{DynamicResource HairBrush}"
                    BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                <Grid>
                    <vlc:VideoView x:Name="Preview"/>
                    <StackPanel x:Name="PreviewLoading" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Открываю видео…" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Первый запуск движка может занять пару секунд"
                                   Foreground="{DynamicResource Tx2Brush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="PreviewError" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <c:Icon Data="{DynamicResource Ico.Alert}" Size="30" Foreground="{DynamicResource Tx3Brush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Не удалось показать видео" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock x:Name="PreviewErrorText" Foreground="{DynamicResource Tx2Brush}" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="520" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ТРАНСПОРТ, ШКАЛА, ГРАНИЦЫ -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,10,16,12" Margin="0,12,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewTime" Text="00:00.000" FontSize="17" FontWeight="SemiBold"
                                       FontFamily="Consolas" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DurationText" Text=" / 00:00.000" FontSize="13" FontFamily="Consolas"
                                       Foreground="{DynamicResource Tx3Brush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource TransportButton}" Click="ToStart_Click" ToolTip="К началу фрагмента (Home)">
                                <c:Icon Data="{DynamicResource Ico.ToStart}" Size="17"/>
                            </Button>
                            <Button Style="{StaticResource TransportButton}" Click="PreviousFrame_Click" Margin="2,0" ToolTip="Кадр назад (←)">
                                <c:Icon Data="{DynamicResource Ico.FrameBack}" Size="17"/>
                            </Button>
                            <Button x:Name="PlayButton" Style="{StaticResource BtnPri}" Width="48" Height="48" Padding="0"
                                    Margin="8,0" Click="Play_Click" ToolTip="Воспроизведение (Space)">
                                <c:Icon x:Name="PlayIcon" Data="{DynamicResource Ico.Play}" Filled="True" Size="20"/>
                            </Button>
                            <Button Style="{StaticResource TransportButton}" Click="NextFrame_Click" Margin="2,0" ToolTip="Кадр вперёд (→)">
                                <c:Icon Data="{DynamicResource Ico.FrameFwd}" Size="17"/>
                            </Button>
                            <Button Style="{StaticResource TransportButton}" Click="ToEnd_Click" ToolTip="К концу фрагмента (End)">
                                <c:Icon Data="{DynamicResource Ico.ToEnd}" Size="17"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <c:Segmented x:Name="SpeedSegment" SelectionChanged="Speed_Changed" ToolTip="Скорость предпросмотра">
                                <ListBoxItem Content="0.5×" Tag="0.5"/>
                                <ListBoxItem Content="1×" Tag="1" IsSelected="True"/>
                                <ListBoxItem Content="2×" Tag="2"/>
                            </c:Segmented>
                            <Button x:Name="MuteButton" Style="{StaticResource TransportButton}" Margin="10,0,4,0"
                                    Click="Mute_Click" ToolTip="Звук (M)">
                                <c:Icon x:Name="MuteIcon" Data="{DynamicResource Ico.Speaker}" Size="17"/>
                            </Button>
                            <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="150" TickFrequency="5"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="2,0,6,0"
                                    ValueChanged="Volume_Changed"
                                    ToolTip="Громкость предпросмотра (↑/↓ шагом 10%). На сохранённый файл не влияет"/>
                            <TextBlock x:Name="VolumeValue" Text="100%" MinWidth="38" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Tx3Brush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="AudioLabel" Text="Поиск звука…" Foreground="{DynamicResource Tx3Brush}"
                                       VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <c:Segmented x:Name="AudioSegment" Visibility="Collapsed" SelectionChanged="AudioTrack_Changed"
                                         ToolTip="Что слышно в предпросмотре и попадёт в сохранённый фрагмент"/>
                        </StackPanel>
                    </Grid>

                    <!-- Разметка времени над шкалой -->
                    <Canvas x:Name="Ruler" Height="18" Margin="0,12,0,0" IsHitTestVisible="False" ClipToBounds="False"/>

                    <!-- Одна шкала: затемнённое отрезается, выделенное сохраняется. -->
                    <Canvas x:Name="Timeline" Height="56" Background="Transparent" Cursor="Hand"
                            SizeChanged="Timeline_SizeChanged"
                            MouseLeftButtonDown="Timeline_MouseLeftButtonDown"
                            MouseLeftButtonUp="Timeline_MouseLeftButtonUp"
                            MouseMove="Timeline_MouseMove" MouseLeave="Timeline_MouseLeave">
                        <Border x:Name="TimelineTrack" Height="40" CornerRadius="8" Background="{DynamicResource Card2Brush}"
                                BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" Canvas.Top="8"/>
                        <Border x:Name="DimBefore" Height="40" Background="#99000000" CornerRadius="8,0,0,8" Canvas.Top="8"/>
                        <Border x:Name="SelectedRange" Height="40" Background="#2645E879"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2" Canvas.Top="8"/>
                        <Border x:Name="DimAfter" Height="40" Background="#99000000" CornerRadius="0,8,8,0" Canvas.Top="8"/>
                        <Rectangle x:Name="HoverLine" Width="1" Height="40" Canvas.Top="8" Fill="{DynamicResource Tx3Brush}"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Grid x:Name="Playhead" Width="12" Height="56" IsHitTestVisible="False">
                            <Rectangle Width="2" Fill="White" HorizontalAlignment="Center"/>
                            <Ellipse Width="10" Height="10" Fill="White" VerticalAlignment="Top"/>
                        </Grid>
                        <primitives:Thumb x:Name="InHandle" Style="{StaticResource TimelineHandle}" Canvas.Top="3"
                                          DragDelta="InHandle_DragDelta" ToolTip="Начало фрагмента"/>
                        <primitives:Thumb x:Name="OutHandle" Style="{StaticResource TimelineHandle}" Canvas.Top="3"
                                          DragDelta="OutHandle_DragDelta" ToolTip="Конец фрагмента"/>
                        <Border x:Name="HoverLabel" Canvas.Top="-24" Background="{DynamicResource Card2Brush}"
                                BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock x:Name="HoverText" FontFamily="Consolas" FontSize="11.5"/>
                        </Border>
                    </Canvas>

                    <!-- Границы фрагмента одной группой по центру: начало, длительность,
                         конец. Раньше кнопки стояли по краям окна, и до каждой надо было
                         тянуться через всю ширину. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Click="SetIn_Click" c:Deco.Icon="{StaticResource Ico.MarkIn}" Content="Начало"
                                Padding="10,0" ToolTip="Поставить начало на текущий кадр (I)"/>
                        <TextBlock x:Name="StartTimeText" Text="00:00.000" FontFamily="Consolas" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,14,0"/>

                        <Border Background="{DynamicResource TrackBrush}" CornerRadius="9" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Фрагмент" Foreground="{DynamicResource Tx2Brush}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="SelectionTimeText" Text="00:00.000" FontFamily="Consolas"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource TransportButton}" Margin="4,0,0,0" Click="Reset_Click"
                                ToolTip="Сбросить границы — весь клип">
                            <c:Icon Data="{DynamicResource Ico.Undo}" Size="15"/>
                        </Button>

                        <TextBlock x:Name="EndTimeText" Text="00:00.000" FontFamily="Consolas" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <Button Click="SetOut_Click" c:Deco.Icon="{StaticResource Ico.MarkOut}" Content="Конец"
                                Padding="10,0" ToolTip="Поставить конец на текущий кадр (O)"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- СОХРАНЕНИЕ -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ExportStatus" Text="Готово к сохранению" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="SizeEstimateText" Foreground="{DynamicResource Tx3Brush}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                        <TextBlock x:Name="ExportHint" Text="Видео копируется без потери качества."
                                   Style="{StaticResource RowSub}" Margin="0,3,12,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="ExportProgress" Height="4" Margin="0,9,14,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OpenFolderButton" Content="Показать в папке" c:Deco.Icon="{DynamicResource Ico.FolderOpen}"
                                Click="OpenFolder_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                        <Button x:Name="CancelExportButton" Content="Отменить" Click="CancelExport_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                        <Button x:Name="ExportButton" Content="Сохранить фрагмент" MinWidth="170" Height="38"
                                Style="{StaticResource BtnPri}" c:Deco.Icon="{DynamicResource Ico.Scissors}"
                                Click="Export_Click" ToolTip="Сохранить выбранный фрагмент (Ctrl+E)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ПОДСКАЗКА ПО КЛАВИШАМ -->
            <WrapPanel Grid.Row="4" Margin="4,10,0,0" HorizontalAlignment="Center">
                <WrapPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Tx3Brush}"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="3,0,16,0"/>
                    </Style>
                </WrapPanel.Resources>
                <c:KeyCaps Combo="Space"/><TextBlock Text="пауза"/>
                <c:KeyCaps Combo="I"/><c:KeyCaps Combo="O"/><TextBlock Text="начало / конец"/>
                <c:KeyCaps Combo="←"/><c:KeyCaps Combo="→"/><TextBlock Text="кадр"/>
                <!-- Колпачок «Shift» вручную: KeyCaps превращает его в «⇧», а в шрифте
                     интерфейса этого глифа нет — выходил пустой прямоугольник. -->
                <Border Background="{DynamicResource TrackBrush}" CornerRadius="6" Margin="0,0,3,0"
                        MinWidth="22" Height="21" Padding="6,0" VerticalAlignment="Center">
                    <TextBlock Text="Shift" FontSize="11" FontWeight="SemiBold" Margin="0"
                               Foreground="{DynamicResource Tx2Brush}" HorizontalAlignment="Center"/>
                </Border>
                <c:KeyCaps Combo="←"/><TextBlock Text="секунда"/>
                <c:KeyCaps Combo="Home"/><c:KeyCaps Combo="End"/><TextBlock Text="к границам"/>
                <c:KeyCaps Combo="M"/><TextBlock Text="звук"/>
                <c:KeyCaps Combo="Ctrl+E"/><TextBlock Text="сохранить"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
