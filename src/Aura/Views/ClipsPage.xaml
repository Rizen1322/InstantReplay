<views:PageBase x:Class="Aura.Views.ClipsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:Aura.Controls"
                xmlns:views="clr-namespace:Aura.Views">

    <Grid MaxWidth="1180" Margin="28,24,20,42" HorizontalAlignment="Stretch">
        <StackPanel>
            <TextBlock Text="Клипы" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Lede}" Text="Считаю записи…"/>

            <!-- Фильтры -->
            <Grid Margin="0,0,8,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <c:Segmented x:Name="TypeFilter" SelectionChanged="Filter_Changed">
                    <ListBoxItem Content="Всё" IsSelected="True"/>
                    <ListBoxItem Content="Клипы"/>
                    <ListBoxItem Content="Скриншоты"/>
                </c:Segmented>

                <ComboBox x:Name="GameFilter" Grid.Column="1" MinWidth="150" Margin="9,0,0,0"
                          SelectionChanged="Filter_Changed"/>

                <ComboBox x:Name="SortOrder" Grid.Column="2" MinWidth="150" Margin="9,0,0,0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Сначала новые" IsSelected="True"/>
                    <ComboBoxItem Content="Сначала старые"/>
                    <ComboBoxItem Content="Крупные первыми"/>
                    <ComboBoxItem Content="По названию"/>
                </ComboBox>

                <!-- Кнопки «Папка» здесь нет: то же самое действие уже живёт в шапке
                     окна («Открыть папку») и дублировать его в фильтрах незачем. -->
                <Button Grid.Column="4" Style="{StaticResource BtnSquare}" Click="Refresh_Click" ToolTip="Обновить список"
                        c:Deco.Icon="{DynamicResource Ico.Refresh}"/>
            </Grid>

            <!-- Панель выделения: появляется, когда что-то выбрано, и едет вместе
                 с прокруткой — кнопки нужны там, где сейчас глаза, а не в начале
                 списка. Тень включается, только когда панель «оторвалась» от своего
                 места: так видно, что она лежит поверх карточек. -->
            <Border x:Name="SelectionBar" Visibility="Collapsed" Margin="0,0,8,14" Panel.ZIndex="10"
                    RenderTransformOrigin="0,0"
                    Background="{DynamicResource GlassBrush}" CornerRadius="12" Padding="14,10,10,10"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <Border.RenderTransform><TranslateTransform x:Name="SelectionBarShift"/></Border.RenderTransform>
                <Grid>
                    <TextBlock x:Name="SelectionText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Одна кнопка на два действия: пока выделено не всё — «Выбрать
                             всё», когда выделено всё — «Снять всё». Отдельная кнопка
                             снятия рядом с «Готово» только путала. -->
                        <Button x:Name="SelectAllButton" Content="Выбрать всё" Click="SelectAll_Click"
                                MinWidth="150" c:Deco.Icon="{DynamicResource Ico.CheckSquare}"/>
                        <Button Content="Копировать пути" Margin="8,0,0,0" Click="CopySelectedPaths_Click"
                                c:Deco.Icon="{DynamicResource Ico.Copy}"/>
                        <Button Content="Удалить" Margin="8,0,0,0" Click="DeleteSelected_Click"
                                Style="{StaticResource BtnDanger}" c:Deco.Icon="{DynamicResource Ico.Trash}"/>
                        <Button Content="Готово" Margin="8,0,0,0" Click="ClearSelection_Click"
                                Style="{StaticResource BtnPri}" c:Deco.Icon="{DynamicResource Ico.Check}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Группы по датам -->
            <StackPanel x:Name="Groups"/>

            <!-- Пусто -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="0,60,0,0" HorizontalAlignment="Center">
                <c:Icon Data="{DynamicResource Ico.Film}" Size="40" Opacity="0.35"
                        Foreground="{DynamicResource Tx3Brush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" Text="Здесь пока пусто" FontFamily="{DynamicResource DispFont}"
                           FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="EmptyHint" Style="{StaticResource RowSub}" TextAlignment="Center" MaxWidth="360"
                           Text="Включи мгновенный повтор и сохрани момент — запись появится здесь."/>
            </StackPanel>
        </StackPanel>
    </Grid>
</views:PageBase>
