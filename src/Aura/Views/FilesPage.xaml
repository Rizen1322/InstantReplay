<views:PageBase x:Class="Aura.Views.FilesPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:Aura.Controls"
                xmlns:views="clr-namespace:Aura.Views">

    <Grid MaxWidth="840" Margin="28,24,28,42" HorizontalAlignment="Stretch">
        <StackPanel>
            <TextBlock Text="Файлы" Style="{StaticResource PageTitle}"/>

            <!-- Сколько занято -->
            <Border Style="{StaticResource CardSoft}" Padding="18">
                <StackPanel>
                    <UniformGrid Rows="1" Columns="3">
                        <StackPanel>
                            <TextBlock x:Name="CountText" Text="—" Style="{StaticResource Numeral}"/>
                            <TextBlock Text="записей сохранено" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="UsedText" Text="—" Style="{StaticResource Numeral}"/>
                            <TextBlock Text="занято" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="FreeText" Text="—" Style="{StaticResource Numeral}"/>
                            <TextBlock Text="свободно на диске" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock x:Name="UsageText" Style="{StaticResource RowSub}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- Папка -->
            <TextBlock Text="Папка записей" Style="{StaticResource GroupLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:AdaptiveRow Margin="16,12,16,12">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Куда сохранять" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="PathText" Style="{StaticResource RowSub}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Открыть" Click="OpenFolder_Click" Margin="0,0,8,0"
                                    c:Deco.Icon="{DynamicResource Ico.FolderOpen}"/>
                            <Button Content="Выбрать…" Click="Browse_Click"
                                    c:Deco.Icon="{DynamicResource Ico.Folder}"/>
                        </StackPanel>
                    </c:AdaptiveRow>

                    <Border Style="{StaticResource RowSeparator}"/>
                    <c:AdaptiveRow Margin="16,12,16,12">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Раскладывать по папкам игр" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="GroupSub" Style="{StaticResource RowSub}"/>
                        </StackPanel>
                        <c:Switch x:Name="GroupByGame" Click="Setting_Changed"/>
                    </c:AdaptiveRow>
                </StackPanel>
            </Border>

            <!-- Внешние программы -->
            <TextBlock Text="Чем обрезать" Style="{StaticResource GroupLabel}"/>
            <Border Style="{StaticResource Card}">
                <c:AdaptiveRow Margin="16,12,16,12">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="LosslessCut" Style="{StaticResource RowLabel}"/>
                        <TextBlock x:Name="TrimToolPath" Style="{StaticResource RowSub}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TrimToolClear" Content="Забыть" Click="TrimToolClear_Click" Margin="0,0,8,0"
                                c:Deco.Icon="{DynamicResource Ico.X}"/>
                        <Button Content="Выбрать…" Click="TrimTool_Click"
                                c:Deco.Icon="{DynamicResource Ico.File}"/>
                    </StackPanel>
                </c:AdaptiveRow>
            </Border>

        </StackPanel>
    </Grid>
</views:PageBase>
