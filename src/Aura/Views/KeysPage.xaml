<views:PageBase x:Class="Aura.Views.KeysPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:Aura.Controls"
                xmlns:views="clr-namespace:Aura.Views">

    <Grid MaxWidth="840" Margin="28,24,28,42" HorizontalAlignment="Stretch">
        <StackPanel>
            <TextBlock Text="Клавиши" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Нажми на поле и введи новое сочетание."
                       Style="{StaticResource Lede}"/>

            <Border x:Name="ConflictBar" Style="{StaticResource Card}" Padding="14,12,14,12"
                    Margin="0,0,0,12" Visibility="Collapsed"
                    Background="{DynamicResource AccentSoftBrush}">
                <StackPanel Orientation="Horizontal">
                    <c:IconTile Data="{DynamicResource Ico.Alert}" Background="{DynamicResource OrangeBrush}"/>
                    <TextBlock x:Name="ConflictText" Style="{StaticResource RowSub}" Margin="12,0,0,0"
                               VerticalAlignment="Center" MaxWidth="620"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="Rows"/>
            </Border>

            <Button Content="Вернуть стандартные" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Reset_Click"/>
        </StackPanel>
    </Grid>
</views:PageBase>
