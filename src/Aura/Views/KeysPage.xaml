<views:PageBase x:Class="Aura.Views.KeysPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:Aura.Controls"
                xmlns:views="clr-namespace:Aura.Views">

    <Grid Margin="20,16,16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="AsideCol" Width="300"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel Margin="0,0,0,40">
                <Grid Margin="2,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Клавиши" Style="{StaticResource PageTitle}" Margin="0"/>
                        <TextBlock Text="Работают поверх любой игры" Style="{StaticResource Lede}" Margin="12,0,0,5" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <Button Content="Вернуть стандартные" HorizontalAlignment="Right" Style="{StaticResource BtnPlain}"
                            Height="30" Click="Reset_Click" c:Deco.Icon="{DynamicResource Ico.Undo}"/>
                </Grid>

                <Border x:Name="ConflictBar" CornerRadius="10" Padding="14,11,14,12" Margin="0,4,0,4"
                        Visibility="Collapsed" Background="{DynamicResource WarnSoftBrush}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{DynamicResource Ico.Alert}" Size="16" Foreground="{DynamicResource OrangeBrush}"
                                VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <TextBlock x:Name="ConflictText" FontSize="12.5" Margin="10,0,0,0" TextWrapping="Wrap"
                                   VerticalAlignment="Center" MaxWidth="620" Foreground="{DynamicResource TxBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Повтор" Style="{StaticResource GroupLabel}" Margin="4,10,4,7"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="Rows"/>
                </Border>

                <TextBlock Text="Запись и скриншоты" Style="{StaticResource GroupLabel}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="Rows2"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="Aside" Grid.Column="1" Margin="2,0,0,0">
            <Border Style="{StaticResource AsidePanel}">
                <StackPanel>
                    <TextBlock Text="Как назначить" Style="{StaticResource AsideTitle}"/>
                    <TextBlock Style="{StaticResource AsideNote}"
                               Text="Нажми на сочетание, затем жми клавишу или кнопку мыши. Esc снимает назначение. Боковые кнопки мыши тоже подходят."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AsidePanel}">
                <StackPanel>
                    <TextBlock Text="Проверка сочетаний" Style="{StaticResource AsideTitle}"/>
                    <TextBlock x:Name="TakenSummary" Style="{StaticResource AsideNote}" Margin="0,0,0,6"/>
                    <Grid x:Name="TakenList">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</views:PageBase>
