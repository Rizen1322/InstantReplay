<views:PageBase x:Class="Aura.Views.OverviewPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:Aura.Controls"
                xmlns:views="clr-namespace:Aura.Views">

    <!-- Главный экран. Живой кадр того, что пишется, лента буфера, управление
         повтором и последние клипы. Всё помещается в окно без прокрутки. -->
    <Grid Margin="16,16,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ControlCol" Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== ЖИВОЙ КАДР И ЛЕНТА ==================== -->
            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="Frame" CornerRadius="8" Background="{DynamicResource WellBrush}" MinHeight="120">
                        <Grid>
                            <Border x:Name="FrameImage" CornerRadius="8"/>
                            <Border x:Name="FrameIdle" CornerRadius="8" Background="{DynamicResource WellBrush}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="IdleTitle" Text="Повтор выключен" FontFamily="{DynamicResource DispFont}"
                                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="IdleSub" Text="Включи, чтобы не упустить момент" Margin="0,5,0,0"
                                               Foreground="{DynamicResource Tx2Brush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Лента буфера: кадр раз в 15 секунд. Тяни по ленте, чтобы выделить
                         последние N секунд: выделение всегда доходит до «сейчас». -->
                    <Grid x:Name="Strip" Grid.Row="1" Height="54" Margin="0,10,0,0" Cursor="SizeWE"
                          Background="Transparent"
                          MouseLeftButtonDown="Strip_Down" MouseMove="Strip_Move" MouseLeftButtonUp="Strip_Up">
                        <Border CornerRadius="8" Background="{DynamicResource WellBrush}"/>
                        <Border CornerRadius="8" ClipToBounds="True">
                            <UniformGrid x:Name="StripFrames" Rows="1" Margin="0"/>
                        </Border>
                        <TextBlock x:Name="StripEmpty" Text="Лента наполнится за минуту" FontSize="12"
                                   Foreground="{DynamicResource Tx3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="Pick" HorizontalAlignment="Right" Width="0" CornerRadius="8"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.1"/>
                            </Border.Background>
                            <Border Width="4" Height="20" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left" Margin="-3,0,0,0"/>
                        </Border>
                        <Border Width="2" HorizontalAlignment="Right" Background="{DynamicResource TxBrush}" IsHitTestVisible="False"/>
                    </Grid>

                    <Grid x:Name="Scale" Grid.Row="2" Margin="2,6,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Scale0" FontSize="11" Foreground="{DynamicResource Tx3Brush}" FontFamily="{DynamicResource DispFont}"/>
                        <TextBlock x:Name="Scale1" Grid.Column="1" FontSize="11" Foreground="{DynamicResource Tx3Brush}" FontFamily="{DynamicResource DispFont}"/>
                        <TextBlock x:Name="Scale2" Grid.Column="2" FontSize="11" Foreground="{DynamicResource Tx3Brush}" FontFamily="{DynamicResource DispFont}"/>
                        <TextBlock Grid.Column="3" Text="сейчас" FontSize="11" Foreground="{DynamicResource Tx3Brush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="2,8,0,0">
                        <TextBlock x:Name="PickInfo" FontSize="12" Foreground="{DynamicResource Tx2Brush}" VerticalAlignment="Center"
                                   Text="Потяни по ленте, чтобы сохранить только последние секунды"/>
                        <Button x:Name="SavePick" HorizontalAlignment="Right" Height="28" Padding="11,0,11,0" FontSize="12"
                                Visibility="Collapsed" Click="SavePick_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== УПРАВЛЕНИЕ ПОВТОРОМ ==================== -->
            <Border x:Name="Control" Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="16,15,16,10">
                        <Grid>
                            <TextBlock Text="Мгновенный повтор" Foreground="{DynamicResource Tx2Brush}" FontSize="13" VerticalAlignment="Center"/>
                            <c:Switch x:Name="Master" HorizontalAlignment="Right" Click="Master_Click"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="BufferTime" Text="0:00" FontFamily="{DynamicResource DispFont}" FontSize="38"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="BufferOf" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Tx3Brush}"
                                       VerticalAlignment="Bottom" Margin="8,0,0,8" FontFamily="{DynamicResource DispFont}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Кратко о настройках: клик ведёт в нужный раздел -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,4">
                        <Button Style="{StaticResource RowButton}" Tag="capture" Click="Go_Click">
                            <Grid Margin="16,8,16,8">
                                <TextBlock Text="Длина повтора" Foreground="{DynamicResource Tx2Brush}" FontSize="13"/>
                                <TextBlock x:Name="LengthText" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Tag="capture" Click="Go_Click">
                            <Grid Margin="16,8,16,8">
                                <TextBlock Text="Качество" Foreground="{DynamicResource Tx2Brush}" FontSize="13"/>
                                <TextBlock x:Name="QualityText" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Tag="audio" Click="Go_Click">
                            <Grid Margin="16,8,16,8">
                                <TextBlock Text="Звук" Foreground="{DynamicResource Tx2Brush}" FontSize="13"/>
                                <TextBlock x:Name="SoundText" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Tag="capture" Click="Go_Click">
                            <Grid Margin="16,8,16,8">
                                <TextBlock Text="Источник" Foreground="{DynamicResource Tx2Brush}" FontSize="13"/>
                                <TextBlock x:Name="SourceText" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Уровни звука -->
                    <StackPanel Grid.Row="2" Margin="16,6,16,0">
                        <Grid x:Name="GameMeterRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Игра" FontSize="12" Foreground="{DynamicResource Tx2Brush}"/>
                            <c:LevelMeter x:Name="GameMeter" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GameDb" Grid.Column="2" FontSize="11" Foreground="{DynamicResource Tx3Brush}"
                                       HorizontalAlignment="Right" FontFamily="{DynamicResource DispFont}"/>
                        </Grid>
                        <Grid x:Name="MicMeterRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Микрофон" FontSize="12" Foreground="{DynamicResource Tx2Brush}"/>
                            <c:LevelMeter x:Name="MicMeter" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MicDb" Grid.Column="2" FontSize="11" Foreground="{DynamicResource Tx3Brush}"
                                       HorizontalAlignment="Right" FontFamily="{DynamicResource DispFont}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Совет в свободном месте панели: на высоком окне здесь пусто -->
                    <Border Grid.Row="3" Margin="16,14,16,0" VerticalAlignment="Bottom" Padding="12,10,12,11"
                            CornerRadius="10" Background="{DynamicResource WellBrush}" ClipToBounds="True">
                        <TextBlock x:Name="TipText" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Tx2Brush}" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="16,12,16,16">
                        <Button x:Name="SaveButton" Style="{StaticResource BtnPri}" Height="40" Click="SaveReplay_Click"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{DynamicResource Ico.Down}" Size="15" Foreground="{DynamicResource AccentInkBrush}"
                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Сохранить повтор" Foreground="{DynamicResource AccentInkBrush}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="SaveKeyBox" Background="#29062A0E" CornerRadius="4" Padding="6,1,6,2" Margin="9,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="SaveKey" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource DispFont}"
                                               Foreground="{DynamicResource AccentInkBrush}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="Save30" Height="38" HorizontalAlignment="Stretch" Click="Save30_Click"
                                    ToolTip="Сохранить только последние 30 секунд">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="30 секунд" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Save30Key" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Tx3Brush}" FontFamily="{DynamicResource DispFont}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RecordButton" Grid.Column="2" Height="38" HorizontalAlignment="Stretch" Click="Record_Click"
                                    ToolTip="Запись в файл без ограничения длины">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="RecordDot" Width="8" Height="8" Fill="{DynamicResource RecBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RecordLabel" Text="Запись" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== ПОСЛЕДНИЕ КЛИПЫ ==================== -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <Grid Margin="2,0,0,8">
                <!-- Одна строка из двух кусков: так подпись стоит на одной базовой
                     линии с заголовком при любом шрифте и масштабе. -->
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Последние клипы" FontFamily="{DynamicResource DispFont}" FontSize="15" FontWeight="SemiBold"/>
                    <Run Text="  " FontSize="12"/>
                    <Run x:Name="RecentCount" FontSize="12" Foreground="{DynamicResource Tx3Brush}"/>
                </TextBlock>
                <Button Content="Все клипы ›" Style="{StaticResource BtnPlain}" Height="26" Padding="8,0,8,0" FontSize="12"
                        HorizontalAlignment="Right" Click="AllClips_Click"/>
            </Grid>

            <ItemsControl x:Name="Recent" ItemTemplate="{StaticResource ClipCard}" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid x:Name="RecentPanel" Rows="1" Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock x:Name="RecentEmpty" Style="{StaticResource RowSub}" Visibility="Collapsed" Margin="2,0,0,8"
                       Text="Записей пока нет. Включи мгновенный повтор и сохрани момент горячей клавишей."/>
        </StackPanel>
    </Grid>
</views:PageBase>
