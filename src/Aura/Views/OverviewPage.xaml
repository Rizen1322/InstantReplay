<views:PageBase x:Class="Aura.Views.OverviewPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:Aura.Controls"
                xmlns:views="clr-namespace:Aura.Views">

    <Grid MaxWidth="840" Margin="28,24,28,42" HorizontalAlignment="Stretch">
        <StackPanel>

            <!-- ==================== ГЛАВНАЯ КАРТОЧКА ====================
                 Фон берётся из палитры: в «Глубокой» теме это градиентное поле,
                 в обычных — та же плоская карточка, что и раньше. -->
            <Border Style="{StaticResource CardSoft}" Padding="22,20,22,18"
                    Background="{DynamicResource HeroBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Tally" Width="7" Height="7" Fill="{DynamicResource Tx3Brush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="Eyebrow" Text="Повтор выключен" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource HeroTx2Brush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                                <TextBlock x:Name="BufferTime" Text="0:00" FontFamily="{DynamicResource DispFont}"
                                           FontSize="46" FontWeight="SemiBold" LineHeight="50"
                                           Foreground="{DynamicResource HeroTxBrush}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="11,0,0,7">
                                    <TextBlock x:Name="BufferHint" Text="включи, чтобы не упустить момент"
                                               FontSize="13" Foreground="{DynamicResource HeroTx2Brush}" VerticalAlignment="Center"/>
                                    <c:KeyCaps x:Name="SaveCombo" Margin="7,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>

                            <WrapPanel x:Name="Pills" Margin="0,10,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <TextBlock Text="Мгновенный повтор" FontSize="11.5" Foreground="{DynamicResource HeroTx2Brush}"
                                       HorizontalAlignment="Right"/>
                            <c:Switch x:Name="Master" Large="True" Margin="0,8,0,0" HorizontalAlignment="Right"
                                      Click="Master_Click"/>
                            <TextBlock x:Name="MasterState" Text="Выключен" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,8,0,0" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource HeroTxBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Шкала буфера -->
                    <Grid Margin="0,18,0,0">
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource HeroTrackBrush}"/>
                        <Border x:Name="BufferFill" Height="10" CornerRadius="5" HorizontalAlignment="Left" Width="0"
                                Background="{DynamicResource HeroFillBrush}"/>
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <TextBlock x:Name="TickLeft" Text="−0:00" Style="{StaticResource Caption3}" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource HeroTx3Brush}"/>
                        <TextBlock Text="сейчас" Style="{StaticResource Caption3}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource HeroTx3Brush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Плиток «Сохранить повтор» и «Начать запись» здесь нет: и то и другое
                 делается горячей клавишей, не отрывая рук от игры, а кнопка
                 сохранения к тому же осталась в шапке окна. -->

            <!-- ==================== КОРОТКО ==================== -->
            <TextBlock Text="Коротко" Style="{StaticResource GroupLabel}"/>
            <UniformGrid x:Name="Stats" Rows="0" Columns="3">
                <Border Style="{StaticResource CardSoft}" Padding="16,15,16,15" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{DynamicResource Ico.Disk}" Size="13" Foreground="{DynamicResource Tx3Brush}"/>
                            <TextBlock Text="Место для записей" Style="{StaticResource Caption}" Margin="7,0,0,0"/>
                        </StackPanel>
                        <!-- Полоски заполнения здесь больше нет: она показывала долю
                             от лимита папки, а автоочистки с лимитом не осталось —
                             шкала без предела всегда была бы пустой. -->
                        <TextBlock x:Name="UsedText" Text="—" Style="{StaticResource Numeral}" Margin="0,9,0,0"/>
                        <TextBlock x:Name="FreeText" Text="" Style="{StaticResource Caption3}" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardSoft}" Padding="16,15,16,15" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{DynamicResource Ico.Film}" Size="13" Foreground="{DynamicResource Tx3Brush}"/>
                            <TextBlock Text="Записей сохранено" Style="{StaticResource Caption}" Margin="7,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ClipCountText" Text="—" Style="{StaticResource Numeral}" Margin="0,9,0,0"/>
                        <TextBlock x:Name="ClipCountSub" Text="" Style="{StaticResource Caption3}"
                                   Margin="0,9,0,0" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardSoft}" Padding="16,15,16,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{DynamicResource Ico.Monitor}" Size="13" Foreground="{DynamicResource Tx3Brush}"/>
                            <TextBlock Text="Качество записи" Style="{StaticResource Caption}" Margin="7,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="QualityText" Text="—" Style="{StaticResource Numeral}" Margin="0,9,0,0"/>
                        <TextBlock x:Name="QualitySub" Text="" Style="{StaticResource Caption3}" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ==================== ПОСЛЕДНИЕ ЗАПИСИ ==================== -->
            <Grid>
                <TextBlock Text="Последние записи" Style="{StaticResource GroupLabel}"/>
                <Button Content="Все клипы" Style="{StaticResource BtnPlain}" Height="26" Padding="8,0,8,0"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" Click="AllClips_Click"/>
            </Grid>

            <ItemsControl x:Name="Recent" ItemTemplate="{StaticResource ClipCard}"
                          ItemsPanel="{StaticResource ClipGridPanel}"/>

            <TextBlock x:Name="RecentEmpty" Style="{StaticResource RowSub}" Visibility="Collapsed"
                       Text="Записей пока нет. Включи мгновенный повтор и сохрани момент горячей клавишей."/>
        </StackPanel>
    </Grid>
</views:PageBase>
