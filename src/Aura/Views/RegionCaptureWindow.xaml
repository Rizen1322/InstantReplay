<Window x:Class="Aura.Views.RegionCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Aura.Views"
        xmlns:c="clr-namespace:Aura.Controls"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="False" Background="Black"
        WindowStartupLocation="Manual" Cursor="Cross" Title="Aura — снимок области">

    <Window.Resources>
        <!-- Стрелки, капли и буквы в наборе приложения нет — рисуем свои в сетке 24×24 -->
        <PathGeometry x:Key="Ico.ArrowTool" Figures="M5 19 L18.5 5.5 M18.5 5.5h-7 M18.5 5.5v7"/>
        <!-- Капля: общепринятый знак размытия -->
        <PathGeometry x:Key="Ico.BlurTool" Figures="M12 3.5c-4.6 5.6-6.5 8.4-6.5 11a6.5 6.5 0 0 0 13 0c0-2.6-1.9-5.4-6.5-11z"/>
        <!-- Буква «А» — знак подписи -->
        <PathGeometry x:Key="Ico.TextTool" Figures="M4.8 19.5 12 4.5l7.2 15 M7.9 14.4h8.2"/>
        <!-- Пипетка: наклонная колба с носиком, общепринятый знак выбора цвета -->
        <PathGeometry x:Key="Ico.Eyedropper" Figures="M17.6 3.6a2.6 2.6 0 0 1 3.7 3.7l-2.1 2.1-3.7-3.7zM14.6 6.6l3.7 3.7-8.6 8.6-4.6 1 1-4.6z"/>

        <!-- Панель инструментов намеренно самостоятельна по стилям: оверлей должен
             выглядеть одинаково независимо от темы приложения и не тянуть словари. -->
        <Style x:Key="ToolButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#E8E8ED"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2E2E38"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E03B3B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8E8ED"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2E2E38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Снимок экрана: оверлей показывает застывшую картинку, поэтому под ним
             можно спокойно двигать мышь и рисовать. -->
        <Image x:Name="Shot" Stretch="Fill" SnapsToDevicePixels="True"/>

        <!-- Затемнение с «окном» на месте выделения -->
        <Path x:Name="Dim" Fill="#8C000000"/>

        <!-- Рамка выделения и всё нарисованное пользователем -->
        <views:InkLayer x:Name="Ink" IsHitTestVisible="False"/>

        <Canvas x:Name="Layer">
            <Border x:Name="Toolbar" Visibility="Collapsed" Background="#1C1C22" CornerRadius="10"
                    BorderBrush="#33FFFFFF" BorderThickness="1" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="Black"/>
                </Border.Effect>
                <!-- Только иконки: подписи растягивали панель шире выделения.
                     Что делает кнопка, объясняет подсказка при наведении. -->
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="PencilBtn" Style="{StaticResource ToolButton}" ToolTip="Карандаш">
                        <c:Icon Data="{DynamicResource Ico.Pencil}" Size="17"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ArrowBtn" Style="{StaticResource ToolButton}" ToolTip="Стрелка">
                        <c:Icon Data="{StaticResource Ico.ArrowTool}" Size="17"/>
                    </ToggleButton>
                    <ToggleButton x:Name="RectBtn" Style="{StaticResource ToolButton}" ToolTip="Прямоугольник">
                        <c:Icon Data="{DynamicResource Ico.Box}" Size="17"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BlurBtn" Style="{StaticResource ToolButton}" ToolTip="Размыть — скрыть ник, почту, ключ">
                        <c:Icon Data="{StaticResource Ico.BlurTool}" Size="17"/>
                    </ToggleButton>
                    <ToggleButton x:Name="TextBtn" Style="{StaticResource ToolButton}" ToolTip="Подпись">
                        <c:Icon Data="{StaticResource Ico.TextTool}" Size="17"/>
                    </ToggleButton>
                    <Border Width="1" Background="#33FFFFFF" Margin="5,6"/>
                    <!-- Толщина линии: кнопка по кругу меняет три значения, а сама точка
                         показывает выбранное — отдельная подпись не нужна. -->
                    <Button x:Name="ThicknessBtn" Style="{StaticResource ActionButton}" ToolTip="Толщина линии">
                        <Ellipse x:Name="ThicknessDot" Width="7" Height="7" Fill="#E8E8ED"/>
                    </Button>

                    <Border Width="1" Background="#33FFFFFF" Margin="5,6"/>
                    <!-- Цвет свёрнут в одну кнопку: семь кружков в ряд занимали больше
                         места, чем все инструменты вместе, и панель переставала влезать
                         над узким выделением. Кнопка сама показывает текущий цвет, а по
                         клику раскрывается палитра вместе с пипеткой. -->
                    <ToggleButton x:Name="ColorBtn" Style="{StaticResource ToolButton}" ToolTip="Цвет и пипетка">
                        <Grid>
                            <Ellipse x:Name="ColorDot" Width="17" Height="17" Fill="#E03B3B"/>
                            <Ellipse Width="17" Height="17" Stroke="#55FFFFFF" StrokeThickness="1"/>
                        </Grid>
                    </ToggleButton>

                    <Border Width="1" Background="#33FFFFFF" Margin="5,6"/>
                    <Button x:Name="UndoBtn" Style="{StaticResource ActionButton}" ToolTip="Убрать последнее (Ctrl+Z)">
                        <c:Icon Data="{DynamicResource Ico.Undo}" Size="17"/>
                    </Button>
                    <!-- Та же стрелка зеркально: отдельной иконки «вернуть» в наборе нет -->
                    <Button x:Name="RedoBtn" Style="{StaticResource ActionButton}" ToolTip="Вернуть отменённое (Ctrl+Y)">
                        <c:Icon Data="{DynamicResource Ico.Undo}" Size="17">
                            <c:Icon.LayoutTransform>
                                <ScaleTransform ScaleX="-1"/>
                            </c:Icon.LayoutTransform>
                        </c:Icon>
                    </Button>

                    <Border Width="1" Background="#33FFFFFF" Margin="5,6"/>
                    <Button x:Name="CopyBtn" Style="{StaticResource ActionButton}" ToolTip="В буфер обмена (Ctrl+C)">
                        <c:Icon Data="{DynamicResource Ico.Copy}" Size="17"/>
                    </Button>
                    <Button x:Name="SaveBtn" Style="{StaticResource ActionButton}" ToolTip="Сохранить в папку (Ctrl+S)">
                        <c:Icon Data="{DynamicResource Ico.Save}" Size="17"/>
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource ActionButton}" Foreground="#FF8A8A" ToolTip="Отмена (Esc)">
                        <c:Icon Data="{DynamicResource Ico.X}" Size="17"/>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="SizeChip" Visibility="Collapsed" Background="#CC1C1C22" CornerRadius="5"
                    Padding="7,3" BorderBrush="#33FFFFFF" BorderThickness="1">
                <TextBlock x:Name="SizeText" Foreground="#E8E8ED" FontSize="12" FontFamily="Consolas"/>
            </Border>

            <!-- Раскрытая палитра. На том же холсте, а не всплывающим окном: оверлей
                 сам растянут поверх всех окон, и отдельный Popup со своим hwnd тут
                 воюет за порядок отрисовки. -->
            <Border x:Name="ColorPanel" Visibility="Collapsed" Background="#1C1C22" CornerRadius="10"
                    BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6,5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Border Width="1" Background="#33FFFFFF" Margin="5,2"/>
                    <!-- Пипетка живёт здесь же: она про цвет, а не про рисование -->
                    <ToggleButton x:Name="EyedropperBtn" Style="{StaticResource ToolButton}"
                                  ToolTip="Пипетка — взять цвет с кадра">
                        <c:Icon x:Name="EyedropperIcon" Data="{StaticResource Ico.Eyedropper}" Size="17"/>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- Что возьмёт пипетка: кружок цвета под курсором и его код -->
            <Border x:Name="ColorPeek" Visibility="Collapsed" Background="#E61C1C22" CornerRadius="6"
                    Padding="6,4" BorderBrush="#55FFFFFF" BorderThickness="1" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Grid VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse x:Name="PeekDot" Width="14" Height="14"/>
                        <Ellipse Width="14" Height="14" Stroke="#66FFFFFF" StrokeThickness="1"/>
                    </Grid>
                    <TextBlock x:Name="PeekText" Foreground="#E8E8ED" FontSize="12"
                               FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Canvas>

        <TextBlock x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0"
                   Foreground="#D8D8E0" FontSize="14" IsHitTestVisible="False"
                   Text="Протяните область мышью · Ctrl — выделить окно целиком · Esc — отмена">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.8" Color="Black"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
