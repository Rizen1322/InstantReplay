<Window x:Class="Aura.Views.VideoAssemblyWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:c="clr-namespace:Aura.Controls"
 Title="Монтаж — Aura" Width="1360" Height="940" MinWidth="960" MinHeight="740"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True" PreviewKeyDown="Montage_KeyDown">
 <Window.Resources>
  <Style x:Key="MontageMediaItem" TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource TxBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Item" Background="Transparent" CornerRadius="4" Padding="2"><ContentPresenter HorizontalAlignment="Stretch"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Card2Brush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MontageCheck" TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Tx2Brush}"/>
   <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Body" Background="Transparent" CornerRadius="6" Padding="8,4">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border x:Name="Box" Width="17" Height="17" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Tx3Brush}" Background="{DynamicResource WellBrush}" Margin="0,0,8,0">
       <c:Icon x:Name="Tick" Data="{DynamicResource Ico.Check}" Size="13" Foreground="{DynamicResource AccentInkBrush}" Visibility="Collapsed"/>
      </Border>
      <ContentPresenter VerticalAlignment="Center"><ContentPresenter.Resources>
       <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"/></Style>
      </ContentPresenter.Resources></ContentPresenter>
     </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="12" Background="{DynamicResource CanvasBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="210"/><RowDefinition Height="8"/><RowDefinition Height="1.1*" MinHeight="290"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <Button x:Name="AddVideos" DockPanel.Dock="Left" Content="＋ Добавить видео" Click="Add_Click" Margin="0,0,16,0" ToolTip="Добавить файлы в проект · Ctrl+O"/>
   <Button DockPanel.Dock="Right" Content="Клавиши" Click="Shortcuts_Click" Margin="16,0,0,0" ToolTip="Горячие клавиши монтажа"/>
   <TextBlock Text="Монтаж" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center"/>
   <TextBlock x:Name="Summary" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="240" MinWidth="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="420"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="10">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="Файлы проекта" FontWeight="SemiBold" Margin="2,0,0,6"/>
     <Border x:Name="TrimPanel" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SepBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0" IsEnabled="False">
      <StackPanel>
       <TextBlock x:Name="SelectedClipName" Text="Выберите клип на шкале" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="НАЧАЛО" Foreground="{DynamicResource Tx3Brush}" FontSize="10"/><TextBlock x:Name="TrimStartTime" FontFamily="Consolas"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="КОНЕЦ" Foreground="{DynamicResource Tx3Brush}" FontSize="10"/><TextBlock x:Name="TrimEndTime" FontFamily="Consolas"/></StackPanel>
       </Grid>
       <TextBlock x:Name="SelectionInfo" Text="Видео и звук связаны · U — разделить" Foreground="{DynamicResource Tx3Brush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
       <ComboBox x:Name="ClipAudio" Visibility="Collapsed" SelectionChanged="ClipAudio_Changed"/>
      </StackPanel>
     </Border>
     <ListBox x:Name="ProjectMedia" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource MontageMediaItem}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ProjectMedia_DoubleClick" PreviewMouseLeftButtonDown="ProjectMedia_MouseDown" PreviewMouseMove="ProjectMedia_MouseMove">
      <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{DynamicResource CardBrush}"><ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></ListBox.Template>
      <ListBox.ItemTemplate><DataTemplate>
       <Grid Margin="2,5"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#202632" CornerRadius="3" Height="46"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/><TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource Tx3Brush}" FontSize="11"/></StackPanel>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#090B10" CornerRadius="8" BorderBrush="{DynamicResource SepBrush}" BorderThickness="1" PreviewMouseDown="Preview_MouseDown">
     <Grid><TextBlock x:Name="EmptyPreview" Text="Перетащите видео на шкалу" Foreground="#8993A5" HorizontalAlignment="Center" VerticalAlignment="Center"/><vlc:VideoView x:Name="AssemblyPreview"/></Grid>
    </Border>
    <DockPanel Grid.Row="1" Margin="0,8,0,0">
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
      <Button Content="|◀" Click="ToStart_Click" ToolTip="В начало · Home" Margin="0,0,6,0"/>
      <Button x:Name="PlayAssembly" Content="▶ Смотреть" Click="PlayAssembly_Click" ToolTip="Space / Enter — воспроизведение · K — пауза" Margin="0,0,10,0"/>
      <CheckBox x:Name="MutePreview" Style="{StaticResource MontageCheck}" Content="Без звука" VerticalAlignment="Center" Checked="Mute_Changed" Unchecked="Mute_Changed"/>
     </StackPanel>
     <TextBlock x:Name="PreviewTime" Text="00:00:00.000 / 00:00:00.000" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="16" MinWidth="250" TextAlignment="Right"/>
    </DockPanel>
   </Grid>
  </Grid>
  <GridSplitter Grid.Row="2" Height="7" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
  <Grid Grid.Row="3">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,6">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Content="−" Click="ZoomOut_Click" ToolTip="Отдалить · − / Ctrl+колесо" Margin="0,0,4,0"/><TextBlock x:Name="ZoomText" Text="100%" Width="52" TextAlignment="Center" VerticalAlignment="Center"/>
     <Button Content="+" Click="ZoomIn_Click" ToolTip="Приблизить · Ctrl+колесо" Margin="4,0,4,0"/><Button Content="Вписать" Click="FitTimeline_Click"/>
    </StackPanel>
    <StackPanel x:Name="EditingButtons" Orientation="Horizontal">
     <Button x:Name="UndoAssembly" Content="↶" Click="UndoAssembly_Click" ToolTip="Отменить · Ctrl+Z" IsEnabled="False" Margin="0,0,6,0"/>
     <Button x:Name="RedoAssembly" Content="↷" Click="RedoAssembly_Click" ToolTip="Повторить · Ctrl+Y / Ctrl+Shift+Z" IsEnabled="False" Margin="0,0,10,0"/>
     <Button Content="✂" Click="SplitAssembly_Click" ToolTip="Разрезать выбранное в позиции курсора · S" Margin="0,0,6,0"/>
     <Button x:Name="LinkAudio" Content="Связаны" Click="LinkAudio_Click" ToolTip="U — отделить звук от видео · G — связать" Margin="0,0,10,0"/>
     <CheckBox x:Name="SnapEdits" Style="{StaticResource MontageCheck}" Content="По кадрам" IsChecked="True" VerticalAlignment="Center" ToolTip="Привязывать обрезку, разрез и сдвиг к границам кадров видео · F8"/>
    </StackPanel>
   </DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
   <Grid Background="#12151C">
    <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Background="#191E28">
     <Border Height="36" BorderBrush="#303744" BorderThickness="0,0,1,1" Padding="12,0"><TextBlock Text="ДОРОЖКИ" FontSize="10" Foreground="{DynamicResource Tx3Brush}" VerticalAlignment="Center"/></Border>
     <Border Height="94" BorderBrush="#303744" BorderThickness="0,0,1,1" Padding="12,10"><StackPanel><TextBlock Text="V1   Видео" FontWeight="SemiBold"/><TextBlock Text="Тяните клип или края" FontSize="10" Foreground="{DynamicResource Tx3Brush}" Margin="0,8,0,0"/></StackPanel></Border>
     <StackPanel x:Name="AudioTrackHeaders"/>
    </StackPanel>
    <ScrollViewer x:Name="TimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" ScrollChanged="TimelineScroll_Changed" PreviewMouseWheel="TimelineScroll_Wheel">
     <c:AssemblyTimeline x:Name="Timeline" AllowDrop="True" DragOver="Timeline_DragOver" Drop="Timeline_Drop" ContextMenuOpening="Timeline_ContextMenuOpening">
      <c:AssemblyTimeline.ContextMenu><ContextMenu Style="{DynamicResource TrayMenu}">
        <ContextMenu.Resources>
         <Style TargetType="MenuItem" BasedOn="{StaticResource TrayMenuItem}"/>
         <Style TargetType="Separator" BasedOn="{StaticResource TrayMenuSeparator}"/>
        </ContextMenu.Resources>
       <MenuItem Header="Обрезать выбранный фрагмент…" Click="Edit_Click"/>
       <MenuItem Header="Разрезать в позиции просмотра" InputGestureText="S" Click="SplitAssembly_Click"/>
       <MenuItem x:Name="MoveLeftMenuItem" Header="Переместить клип влево" Click="Up_Click"/>
       <MenuItem x:Name="MoveRightMenuItem" Header="Переместить клип вправо" Click="Down_Click"/>
       <MenuItem Header="Удалить выбранное" InputGestureText="Delete" Click="Remove_Click"/>
       <Separator/>
       <MenuItem Header="Заглушить / включить звуковой фрагмент" Click="MuteAudioEvent_Click"/>
       <MenuItem Header="Отделить звук от видео" InputGestureText="U" Click="UnlinkAudio_Click"/>
       <MenuItem Header="Связать видео и звук" InputGestureText="G" Click="RelinkAudio_Click"/>
       <Separator/><MenuItem Header="Отменить" InputGestureText="Ctrl+Z" Click="UndoAssembly_Click"/>
      </ContextMenu></c:AssemblyTimeline.ContextMenu>
     </c:AssemblyTimeline>
    </ScrollViewer>
   </Grid>
   </ScrollViewer>
   <TextBlock x:Name="TimelineHint" Grid.Row="2" Text="Тяните видео и звук по шкале (Shift — без магнита) · U — отделить звук · Z / X — mute / solo · колесо над звуком — громкость" Foreground="{DynamicResource Tx3Brush}" FontSize="12" Height="22" VerticalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
  </Grid>
  <Grid Grid.Row="4" Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center">
    <TextBlock x:Name="Status" Text="Исходные файлы сохраняются." TextWrapping="Wrap" FontSize="12" MinHeight="22" Foreground="{DynamicResource Tx3Brush}" Margin="0,0,12,0"/>
    <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="1" Margin="0,6,12,0" Visibility="Collapsed"/>
   </StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="Save" Content="Сохранить ролик…" Style="{StaticResource BtnPri}" Click="Save_Click" ToolTip="Целый MP4 по возможности сохраняется в исходном формате без потери качества."/><Button x:Name="CancelExport" Content="Отменить сохранение" Click="Cancel_Click" Visibility="Collapsed" Margin="0,6,0,0"/></StackPanel>
  </Grid>
  <ListBox x:Name="Segments" Visibility="Collapsed" SelectionChanged="Segments_SelectionChanged"/>
  <Slider x:Name="AssemblyPosition" Visibility="Collapsed" Minimum="0" Maximum="1" ValueChanged="AssemblyPosition_Changed"/>
  <Slider x:Name="TrimStart" Visibility="Collapsed" Minimum="0" Maximum="1" ValueChanged="Trim_Changed"/>
  <Slider x:Name="TrimEnd" Visibility="Collapsed" Minimum="0" Maximum="1" ValueChanged="Trim_Changed"/>
 </Grid>
</Window>
