<Window x:Class="Aura.Views.VideoAssemblyWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
 Title="Монтаж — Aura" Width="1180" Height="860" MinWidth="920" MinHeight="780"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True">
 <Grid Margin="22,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <Button x:Name="AddVideos" DockPanel.Dock="Right" Content="Добавить видео…" Click="Add_Click"/>
   <StackPanel><TextBlock Text="Монтаж" Style="{StaticResource PageTitle}"/><TextBlock Text="Общий предпросмотр и шкала. Выберите клип в ленте, чтобы изменить его границы." Style="{StaticResource Lede}"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#090B10" CornerRadius="8" MinHeight="180">
   <Grid><TextBlock Text="Добавьте видео для предпросмотра" Foreground="#999DA8" HorizontalAlignment="Center" VerticalAlignment="Center"/><vlc:VideoView x:Name="AssemblyPreview"/></Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,10,0,10">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
     <Button x:Name="PlayAssembly" Content="▶ Смотреть ролик" Click="PlayAssembly_Click" Margin="0,0,8,0"/>
     <Button Content="В начало" Click="ToStart_Click" Margin="0,0,12,0"/>
     <CheckBox x:Name="MutePreview" Content="Без звука" VerticalAlignment="Center" Checked="Mute_Changed" Unchecked="Mute_Changed"/>
    </StackPanel>
    <TextBlock x:Name="PreviewTime" Text="00:00 / 00:00" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
   </DockPanel>
   <Slider Grid.Row="1" x:Name="AssemblyPosition" Width="Auto" HorizontalAlignment="Stretch" Minimum="0" Maximum="1" Margin="0,10,0,0" IsMoveToPointEnabled="True" ValueChanged="AssemblyPosition_Changed" ToolTip="Позиция в готовом ролике"/>
  </Grid>
  <StackPanel Grid.Row="3">
   <DockPanel Margin="0,0,0,6">
    <StackPanel x:Name="EditingButtons" DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Content="←" Click="Up_Click" ToolTip="Передвинуть раньше" Margin="0,0,6,0"/>
     <Button Content="→" Click="Down_Click" ToolTip="Передвинуть позже" Margin="0,0,6,0"/>
     <Button Content="Разрезать здесь" Click="SplitAssembly_Click" ToolTip="Разделить выбранный клип в позиции просмотра" Margin="0,0,6,0"/>
     <Button Content="Убрать клип" Click="Remove_Click" Margin="0,0,6,0"/>
     <Button x:Name="UndoAssembly" Content="Отменить" Click="UndoAssembly_Click" IsEnabled="False"/>
    </StackPanel>
    <TextBlock x:Name="Summary" VerticalAlignment="Center"/>
   </DockPanel>
   <ListBox x:Name="Segments" Height="126" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource SepBrush}" SelectionChanged="Segments_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate>
     <Grid Width="188" Margin="4" ToolTip="{Binding Path}">
      <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="#151821" CornerRadius="4"><Image Loaded="Thumbnail_Loaded" Stretch="UniformToFill"/></Border>
      <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
      <TextBlock Grid.Row="2" Text="{Binding Range}" Foreground="{DynamicResource Tx3Brush}" FontSize="11"/>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </StackPanel>
  <Border Grid.Row="4" x:Name="TrimPanel" Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="12" Margin="0,10,0,10" IsEnabled="False">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="SelectedClipName" Grid.ColumnSpan="2" FontWeight="SemiBold" Text="Выберите клип" TextTrimming="CharacterEllipsis" Margin="0,0,10,6"/>
    <ComboBox Grid.Column="2" x:Name="ClipAudio" SelectionChanged="ClipAudio_Changed" ToolTip="Звук выбранного клипа"/>
    <Button Grid.Row="1" Content="Начало здесь" Click="MarkStart_Click" Margin="0,2,10,2"/>
    <Slider Grid.Row="1" Grid.Column="1" x:Name="TrimStart" Width="Auto" HorizontalAlignment="Stretch" Minimum="0" Maximum="1" ValueChanged="Trim_Changed" IsMoveToPointEnabled="True"/>
    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TrimStartTime" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
    <Button Grid.Row="2" Content="Конец здесь" Click="MarkEnd_Click" Margin="0,2,10,2"/>
    <Slider Grid.Row="2" Grid.Column="1" x:Name="TrimEnd" Width="Auto" HorizontalAlignment="Stretch" Minimum="0" Maximum="1" ValueChanged="Trim_Changed" IsMoveToPointEnabled="True"/>
    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TrimEndTime" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
   </Grid>
  </Border>
  <Grid Grid.Row="5">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <WrapPanel x:Name="ExportOptions">
     <CheckBox x:Name="LimitSize" Content="Уместить в" VerticalAlignment="Center"/>
     <TextBox x:Name="SizeLimit" Width="58" MaxLength="4" Margin="8,0" VerticalContentAlignment="Center"/>
     <TextBlock Text="МБ" VerticalAlignment="Center" Margin="0,0,16,0"/>
     <Button Content="Дополнительные форматы…" Click="ChooseFfmpeg_Click"/>
    </WrapPanel>
    <TextBlock x:Name="Status" Text="Клипы проигрываются подряд. Исходные файлы сохраняются." TextWrapping="Wrap" Foreground="{DynamicResource Tx3Brush}" Margin="0,6,12,0"/>
    <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="1" Margin="0,6,12,0" Visibility="Collapsed"/>
   </StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <Button x:Name="Save" Content="Сохранить ролик…" Style="{StaticResource BtnPri}" Click="Save_Click"/>
    <Button x:Name="CancelExport" Content="Отменить сохранение" Click="Cancel_Click" Visibility="Collapsed" Margin="0,6,0,0"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
