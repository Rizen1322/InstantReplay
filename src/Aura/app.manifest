<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="InstantReplay.App"/>

  <!--
    Привязка к sparse-пакету identity (packaging with external location).
    Без package identity Windows не выдаёт право graphicsCaptureWithoutBorder, и
    жёлтая рамка записи остаётся: IsBorderRequired = false принимается, но молча
    игнорируется. Пакет содержит только манифест с объявленной возможностью,
    файлы приложения и установщик остаются прежними.
    Значения обязаны совпадать с packaging\AppxManifest.xml:
    publisher = Identity/@Publisher, packageName = Identity/@Name,
    applicationId = Application/@Id. Расхождение = 0x80073D54 (регистрация
    проходит, а identity в рантайме нет).
  -->
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=Rizen1322"
        packageName="Rizen1322.Aura"
        applicationId="Aura" />
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10/11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!--
    Права администратора нужны для глобальных хоткеев ПОВЕРХ ИГР.
    Низкоуровневый хук клавиатуры (WH_KEYBOARD_LL) из обычного процесса не
    получает клавиши от окон с более высокими правами (Windows UIPI) — а CS2,
    Valorant и другие игры с анти-читом работают именно так. Без elevation
    хоткеи «мертвы» в игре, хотя срабатывают на рабочем столе.
    requireAdministrator: запуск ВСЕГДА от администратора. Раньше стоял
    highestAvailable — на обычном аккаунте он молча стартовал без прав, и хоткеи
    в играх не работали без единого намёка на причину. Плата: ручной запуск
    всегда показывает запрос UAC (автозапуск через Планировщик задач — нет,
    там RunLevel=Highest, см. StartupManager).
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Per-Monitor V2 DPI: критично для корректного захвата и оверлея -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
