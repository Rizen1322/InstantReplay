<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>InstantReplay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged-приложение: обычный exe, без MSIX -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ВАЖНО: первые три числа AssemblyVersion должны совпадать с тегом релиза
         (v1.0.1 → 1.0.1.0). Автообновление сравнивает тег с AssemblyVersion, и при
         1.0.0.1 приложение считало бы уже установленный релиз v1.0.1 новее себя —
         и предлагало бы его снова после каждого обновления. -->
    <AssemblyVersion>1.0.12.0</AssemblyVersion>
    <FileVersion>1.0.12.0</FileVersion>
    <Version>1.0.12</Version>

    <!-- Чистая папка установки: только английские ресурсы вместо ~100 языковых папок -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Символы в релиз не кладём -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <!-- Direct3D11 / DXGI / Media Foundation обёртки -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.6.2" />
    <!-- WASAPI-захват и ресемплинг. Только нужные пакеты: мета-пакет NAudio тянет
         NAudio.WinForms и вместе с ним 23 МБ System.Windows.Forms в поставку. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <!-- Иконка в трее для WinUI 3 -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.4" />
    <!-- WMI -->
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
