<Window
    x:Class="InstantReplay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Instant Replay">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Тонкая перетаскиваемая полоса титлбара -->
        <Grid x:Name="TitleBarArea" Background="Transparent"/>

        <!-- Шапка: заголовок + статус слева, действия справа -->
        <Grid Grid.Row="1" Padding="28,0,20,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Instant Replay" FontSize="28" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="Gray" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Выключено" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusDetail" Text="" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Кнопки скриншота в шапке нет: действие осталось на горячей клавише
                     и в меню трея, а в окне оно только занимало место. -->
                <Button x:Name="RecBtn" Click="Rec_Click" Height="34">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="RecDot" Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="RecBtnText" Text="Начать запись"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SaveReplayBtn" Style="{StaticResource AccentButtonStyle}"
                        Click="SaveReplay_Click" IsEnabled="False" Height="34">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                        <TextBlock Text="Сохранить повтор"/>
                    </StackPanel>
                </Button>
                <ToggleSwitch x:Name="BufferSwitch" OnContent="Вкл" OffContent="Выкл"
                              Toggled="Buffer_Toggled" Margin="10,0,0,0" MinWidth="0"/>
            </StackPanel>
        </Grid>

        <!-- Вкладки -->
        <SelectorBar x:Name="Tabs" Grid.Row="2" Margin="22,2,20,0" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem x:Name="TabOverview" Text="Обзор">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE80F;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabRecording" Text="Запись">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE714;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Клипы">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE786;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Клавиши и файлы">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE765;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Приложение">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE713;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Характеристики">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE950;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <Frame x:Name="ContentFrame" Grid.Row="3"/>
    </Grid>
</Window>
