<Page
    x:Class="InstantReplay.Views.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="28,12,28,0">
        <StackPanel Spacing="10" HorizontalAlignment="Stretch">

            <TextBlock Text="Настройки этой вкладки применяются сразу — кнопки «Применить» здесь нет."
                       Style="{StaticResource RowSub}" Margin="0,0,0,4"/>

            <TextBlock Text="Запуск" Style="{StaticResource SectionHeader}"/>
            <Grid Style="{StaticResource SettingCard}">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Автозапуск вместе с Windows" Style="{StaticResource RowLabel}"/>
                        <ToggleSwitch x:Name="AutostartToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                      HorizontalAlignment="Right" MinWidth="0" Toggled="System_Changed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Запускать свёрнутым в трей" Style="{StaticResource RowLabel}"/>
                        <ToggleSwitch x:Name="TrayStartToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                      HorizontalAlignment="Right" MinWidth="0" Toggled="System_Changed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Включать Instant Replay при старте" Style="{StaticResource RowLabel}"/>
                        <ToggleSwitch x:Name="AutoBufferToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                      HorizontalAlignment="Right" MinWidth="0" Toggled="System_Changed"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <TextBlock Text="Уведомления и звук" Style="{StaticResource SectionHeader}" Margin="0,16,0,2"/>
            <Grid Style="{StaticResource SettingCard}">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Показывать уведомления" Style="{StaticResource RowLabel}"/>
                        <ToggleSwitch x:Name="NotifyToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                      HorizontalAlignment="Right" MinWidth="0" Toggled="System_Changed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Положение на экране" Style="{StaticResource RowLabel}"/>
                        <ComboBox x:Name="NotifyPosBox" Grid.Column="1" MinWidth="200" SelectionChanged="System_Changed">
                            <ComboBoxItem Content="Сверху справа" Tag="TopRight"/>
                            <ComboBoxItem Content="Сверху слева" Tag="TopLeft"/>
                            <ComboBoxItem Content="Сверху по центру" Tag="TopCenter"/>
                            <ComboBoxItem Content="Снизу справа" Tag="BottomRight"/>
                            <ComboBoxItem Content="Снизу слева" Tag="BottomLeft"/>
                        </ComboBox>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Длительность показа (сек)" Style="{StaticResource RowLabel}"/>
                        <NumberBox x:Name="DurationBox" Grid.Column="1" Minimum="1" Maximum="15"
                                   SmallChange="0.5" SpinButtonPlacementMode="Compact" MinWidth="160"
                                   ValueChanged="Duration_Changed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Звук при сохранении" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="Сигнал, что повтор успешно сохранён" Style="{StaticResource RowSub}"/>
                        </StackPanel>
                        <ComboBox x:Name="SoundBox" Grid.Column="1" MinWidth="150" SelectionChanged="Sound_Changed">
                            <ComboBoxItem Content="Откл." Tag="None"/>
                            <ComboBoxItem Content="Classic" Tag="Classic"/>
                            <ComboBoxItem Content="Мягкий" Tag="Soft"/>
                            <ComboBoxItem Content="Свой файл…" Tag="Custom"/>
                        </ComboBox>
                        <Button Grid.Column="2" Margin="8,0,0,0" Click="PlaySound_Click"
                                VerticalAlignment="Center" ToolTipService.ToolTip="Прослушать">
                            <FontIcon Glyph="&#xE768;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Открывать папку после сохранения" Style="{StaticResource RowLabel}"/>
                        <ToggleSwitch x:Name="OpenAfterToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                      HorizontalAlignment="Right" MinWidth="0" Toggled="System_Changed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Тема оформления" Style="{StaticResource RowLabel}"/>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="200" SelectionChanged="System_Changed">
                            <ComboBoxItem Content="Тёмная" Tag="Dark"/>
                            <ComboBoxItem Content="Светлая" Tag="Light"/>
                            <ComboBoxItem Content="Системная" Tag="System"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Grid>

            <TextBlock Text="Обновления" Style="{StaticResource SectionHeader}" Margin="0,16,0,2"/>
            <Grid Style="{StaticResource SettingCard}">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="VersionText" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource RowSub}"/>
                        </StackPanel>
                        <Button x:Name="CheckBtn" Grid.Column="1" Content="Проверить"
                                VerticalAlignment="Center" Click="CheckUpdates_Click"/>
                    </Grid>

                    <StackPanel x:Name="UpdatePanel" Spacing="10" Visibility="Collapsed">
                        <ProgressBar x:Name="UpdateProgress" Height="6" Minimum="0" Maximum="1"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="InstallUpdateBtn" Content="Скачать и установить"
                                    Style="{StaticResource AccentButtonStyle}" Click="InstallUpdate_Click"/>
                            <Button x:Name="ReleaseBtn" Content="Открыть страницу релиза" Click="OpenRelease_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <InfoBar x:Name="UpdateWarnBar" Severity="Informational" IsClosable="False" IsOpen="False"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Проверять обновления при запуске" Style="{StaticResource RowLabel}"/>
                        <ToggleSwitch x:Name="UpdatesToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                      HorizontalAlignment="Right" MinWidth="0" Toggled="System_Changed"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Открыть логи" Click="OpenLogs_Click"/>
                <Button Content="Открыть settings.json" Click="OpenSettings_Click"/>
                <Button Content="Сбросить все настройки" Click="Reset_Click"/>
            </StackPanel>

            <TextBlock x:Name="FooterText" Style="{StaticResource RowSub}" Margin="0,4,0,16"/>
        </StackPanel>
    </ScrollViewer>
</Page>
