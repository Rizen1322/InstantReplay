<Page
    x:Class="InstantReplay.Views.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Padding="28,12,28,0">
            <StackPanel Spacing="10" HorizontalAlignment="Stretch">

                <InfoBar x:Name="ActiveBar" Severity="Informational" IsClosable="False"
                         Title="Запись активна"
                         Message="Параметры захвата заблокированы, чтобы не прерывать запись. Выключи Instant Replay для изменения разрешения, FPS, кодека или аудиоустройств. Громкость можно менять на лету."/>

                <!-- Громкости наверху: единственное, что меняют на лету прямо во
                     время записи. Устройства и режим дорожек задаются один раз. -->
                <TextBlock Text="Громкости" Style="{StaticResource SectionHeader}"/>
                <Grid Style="{StaticResource SettingCard}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Громкость игры" Style="{StaticResource RowLabel}"/>
                                <ProgressBar x:Name="GameLevel" Maximum="1" Value="0" Height="3"/>
                            </StackPanel>
                            <Slider x:Name="GameVolSlider" Grid.Column="1" Minimum="0" Maximum="200"
                                    VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                            <TextBlock x:Name="GameVolText" Grid.Column="2" Text="100%"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Громкость микрофона" Style="{StaticResource RowLabel}"/>
                                <ProgressBar x:Name="MicLevel" Maximum="1" Value="0" Height="3"/>
                            </StackPanel>
                            <Slider x:Name="MicVolSlider" Grid.Column="1" Minimum="0" Maximum="200"
                                    VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                            <TextBlock x:Name="MicVolText" Grid.Column="2" Text="100%"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Полоски показывают живой уровень сигнала, когда запись включена"
                                   Style="{StaticResource RowSub}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Источники звука" Style="{StaticResource SectionHeader}" Margin="0,16,0,2"/>
                <Grid x:Name="SourcesCard" Style="{StaticResource SettingCard}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Звук игры (системный)" Style="{StaticResource RowLabel}"/>
                            <ToggleSwitch x:Name="GameAudioToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                          HorizontalAlignment="Right" MinWidth="0"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Микрофон" Style="{StaticResource RowLabel}"/>
                            <ToggleSwitch x:Name="MicToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                          HorizontalAlignment="Right" MinWidth="0"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Режим дорожек" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="TrackModeBox" Grid.Column="1" MinWidth="280">
                                <ComboBoxItem Content="Одна дорожка (игра + микрофон)" Tag="Mixed"/>
                                <ComboBoxItem Content="Две отдельные дорожки" Tag="Separate"/>
                                <ComboBoxItem Content="Только игра" Tag="GameOnly"/>
                                <ComboBoxItem Content="Только микрофон" Tag="MicOnly"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Устройства и обработка: выбираются один раз, обычно «по умолчанию» -->
                <Expander x:Name="DevicesExpander" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" Margin="0,10,0,10">
                    <Expander.Header>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Устройства и обработка" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DevicesSummary" Style="{StaticResource RowSub}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="16" Margin="0,4,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Устройство вывода" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="RenderDeviceBox" Grid.Column="1" MinWidth="280"
                                      SelectionChanged="Device_Changed"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Устройство микрофона" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="CaptureDeviceBox" Grid.Column="1" MinWidth="280"
                                      SelectionChanged="Device_Changed"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Шумоподавление микрофона" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Убирает фоновый гул, но нагружает CPU" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="NoiseToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                          HorizontalAlignment="Right" MinWidth="0" Toggled="Device_Changed"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Padding="28,10,28,14">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="Открыть папку записей" Click="OpenFolder_Click"/>
                <Button x:Name="ApplyBtn" Content="Применить" Style="{StaticResource AccentButtonStyle}"
                        MinWidth="110" Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
