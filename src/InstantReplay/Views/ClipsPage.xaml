<Page
    x:Class="InstantReplay.Views.ClipsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lib="using:InstantReplay.Core.Library"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Карточка клипа. Корень — Button: даёт клавиатурную навигацию, фокус и
             клик бесплатно, в отличие от Grid с ручным Tapped. -->
        <Style x:Key="ClipCardStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <DataTemplate x:Key="ClipCardTemplate" x:DataType="lib:ClipItem">
            <!-- DataContext задаётся ЯВНО: ItemsRepeater при шаблоне на x:Bind не
                 проставляет его сам (данные идут через сгенерированный код привязок).
                 Из-за этого обработчики, читающие DataContext, получали null — карточки
                 рисовались, но не открывались и не запрашивали миниатюру. -->
            <Button Style="{StaticResource ClipCardStyle}" Width="288"
                    DataContext="{x:Bind}"
                    Click="Card_Click"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited"
                    RightTapped="Card_RightTapped"
                    EffectiveViewportChanged="Card_ViewportChanged"
                    ToolTipService.ToolTip="{x:Bind FileName}">

                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Открыть в плеере" Click="MenuOpen_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Показать в папке" Click="MenuReveal_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Копировать путь" Click="MenuCopy_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Переименовать" Click="MenuRename_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Удалить в корзину" Click="MenuDelete_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.ContextFlyout>

                <StackPanel Spacing="9">
                    <!-- Превью 288×162 = 16:9 -->
                    <Grid Height="162">
                        <!-- Заглушка под миниатюрой: карточка не «прыгает», пока кадр грузится -->
                        <Border CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2B343A" Offset="0"/>
                                    <GradientStop Color="#12171A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <FontIcon Glyph="{x:Bind PlaceholderGlyph}" FontSize="26" Opacity="0.3"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border CornerRadius="10">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Затемнение снизу, чтобы плашки читались на любом кадре -->
                        <Border CornerRadius="10" VerticalAlignment="Bottom" Height="58" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#AA000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border CornerRadius="10" BorderThickness="1" IsHitTestVisible="False"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>

                        <Border Visibility="{x:Bind NewVisibility, Mode=OneWay}"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                Background="{StaticResource AccentGreenBrush}"
                                CornerRadius="4" Padding="6,1,6,2">
                            <TextBlock Text="НОВОЕ" FontSize="10" FontWeight="Bold" Foreground="#0B0E10"/>
                        </Border>

                        <Border Visibility="{x:Bind DurationVisibility, Mode=OneWay}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                Background="#B3000000" CornerRadius="4" Padding="6,1,6,2">
                            <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" FontSize="11"
                                       FontWeight="SemiBold" Foreground="White"/>
                        </Border>

                        <!-- Кружок Play проявляется при наведении (см. Card_PointerEntered) -->
                        <Border x:Name="PlayOverlay" Width="46" Height="46" CornerRadius="23" Opacity="0"
                                Background="#CC000000" BorderThickness="1" BorderBrush="#40FFFFFF"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White"/>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="2" Margin="2,0,2,0">
                        <TextBlock Text="{x:Bind Title}" FontSize="13.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   HorizontalAlignment="Left"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Секция одного дня: заголовок + сетка карточек -->
        <DataTemplate x:Key="ClipSectionTemplate" x:DataType="lib:ClipGroup">
            <StackPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,10">
                    <Rectangle Width="3" Height="16" RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                               Fill="{StaticResource AccentGreenBrush}"/>
                    <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <ItemsRepeater ItemsSource="{x:Bind Items}"
                               ItemTemplate="{StaticResource ClipCardTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="288" MinItemHeight="215"
                                           MinColumnSpacing="16" MinRowSpacing="14"
                                           ItemsJustification="Start"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: сводка слева, фильтры справа -->
        <Grid Padding="28,10,22,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Панорама записей" Style="{StaticResource SectionHeader}" Margin="0"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource RowSub}" Margin="0"/>
            </StackPanel>

            <TextBox x:Name="SearchBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                     PlaceholderText="Поиск по названию" TextChanged="Search_Changed"/>

            <ComboBox x:Name="GameBox" Grid.Column="2" MinWidth="150" VerticalAlignment="Center"
                      SelectionChanged="Filter_Changed"/>

            <ComboBox x:Name="TypeBox" Grid.Column="3" MinWidth="120" VerticalAlignment="Center"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Всё"/>
                <ComboBoxItem Content="Клипы"/>
                <ComboBoxItem Content="Скриншоты"/>
            </ComboBox>

            <ComboBox x:Name="SortBox" Grid.Column="4" MinWidth="160" VerticalAlignment="Center"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Сначала новые"/>
                <ComboBoxItem Content="Сначала старые"/>
                <ComboBoxItem Content="Крупные первыми"/>
                <ComboBoxItem Content="По названию"/>
            </ComboBox>

            <Button Grid.Column="5" Click="Refresh_Click" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Обновить список">
                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
            </Button>
            <Button Grid.Column="6" Click="OpenFolder_Click" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Открыть папку записей">
                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
            </Button>
        </Grid>

        <!-- Кадры для превью даёт системный поставщик миниатюр: для HEVC он молчит,
             пока не установлено расширение. На сами файлы это не влияет. -->
        <InfoBar x:Name="CodecBar" Grid.Row="1" Margin="28,0,20,8" Severity="Warning" IsOpen="False"
                 Title="Windows не показывает кадры этих клипов"
                 Message="Клипы записаны в HEVC, а в системе нет декодера — поэтому вместо превью заглушки. Поставьте бесплатное расширение из Microsoft Store или переключите кодек на H.264 на вкладке «Запись». Сами файлы рабочие и открываются в плеере, который их понимает.">
            <InfoBar.ActionButton>
                <Button Content="Открыть расширение в Store" Click="InstallHevc_Click"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Секции по датам, внутри каждой — сетка карточек -->
        <ScrollViewer x:Name="Scroller" Grid.Row="2" Padding="28,0,20,20"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <ItemsRepeater x:Name="Sections" ItemTemplate="{StaticResource ClipSectionTemplate}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="0"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Пусто / ничего не найдено -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" Spacing="10" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
            <FontIcon Glyph="&#xE786;" FontSize="40" Opacity="0.35"/>
            <TextBlock x:Name="EmptyTitle" Text="Здесь пока пусто" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyHint" Style="{StaticResource RowSub}" TextAlignment="Center"
                       Text="Включи Instant Replay и сохрани повтор горячей клавишей — клип появится здесь."/>
            <Button Content="Открыть папку записей" Click="OpenFolder_Click" HorizontalAlignment="Center"/>
        </StackPanel>

        <ProgressRing x:Name="LoadRing" Grid.Row="2" Width="34" Height="34" IsActive="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

    </Grid>
</Page>
