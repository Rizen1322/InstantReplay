<Page
    x:Class="InstantReplay.Views.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Padding="28,12,28,0">
            <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                <InfoBar x:Name="ActiveBar" Severity="Informational" IsClosable="False"
                         Title="Запись активна"
                         Message="Параметры захвата заблокированы, чтобы не прерывать запись. Горячие клавиши можно менять всегда."/>

                <TextBlock Text="Глобальные горячие клавиши" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Работают поверх любой игры. Кликни по полю и нажми новое сочетание."
                           Style="{StaticResource SectionSub}"/>

                <Grid Style="{StaticResource SettingCard}">
                    <StackPanel x:Name="RowsPanel" Spacing="14"/>
                </Grid>

                <Button Content="Сбросить на стандартные" Click="Reset_Click" Margin="0,4,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Padding="28,10,28,14">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="Открыть папку записей" Click="OpenFolder_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
