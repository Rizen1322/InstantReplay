<Page
    x:Class="InstantReplay.Views.KeysFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Padding="28,12,28,0">
            <StackPanel Spacing="10" HorizontalAlignment="Stretch">

                <!-- Горячие клавиши первыми: их меняют чаще, чем папку записей -->
                <TextBlock Text="Горячие клавиши" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Работают поверх любой игры. Кликни по полю и нажми новое сочетание — оно применяется сразу."
                           Style="{StaticResource SectionSub}"/>

                <InfoBar x:Name="ConflictBar" Severity="Warning" IsClosable="False" IsOpen="False"
                         Title="Проверьте назначения"/>

                <Grid Style="{StaticResource SettingCard}">
                    <StackPanel x:Name="RowsPanel" Spacing="14"/>
                </Grid>

                <Button Content="Сбросить клавиши на стандартные" Click="ResetHotkeys_Click" Margin="0,4,0,0"/>

                <!-- Куда всё складывается -->
                <TextBlock Text="Папка записей" Style="{StaticResource SectionHeader}" Margin="0,20,0,2"/>
                <Grid Style="{StaticResource SettingCard}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="SavedCountText" Text="0" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="повторов сохранено" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="UsedText" Text="—" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="занято записями" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock x:Name="FreeText" Text="—" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="свободно на диске" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="UsagePanel" Spacing="4">
                            <ProgressBar x:Name="UsageBar" Height="6" Minimum="0" Maximum="100"/>
                            <TextBlock x:Name="UsageText" Style="{StaticResource RowSub}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Куда сохранять" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="PathText" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Выбрать…" Click="Browse_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Автоудаление старых записей" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Когда места станет мало, самые старые клипы удаляются сами"
                                           Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoDeleteToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                          HorizontalAlignment="Right" MinWidth="0" Toggled="Setting_Changed"/>
                        </Grid>

                        <!-- Лимиты нужны только при включённом автоудалении: без него
                             цифра «лимит папки» ни на что не влияет и только путает. -->
                        <StackPanel x:Name="LimitsPanel" Spacing="16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Лимит размера папки (ГБ)" Style="{StaticResource RowLabel}"/>
                                <NumberBox x:Name="MaxFolderBox" Grid.Column="1" Minimum="0" Maximum="5000"
                                           SpinButtonPlacementMode="Compact" MinWidth="160"
                                           ValueChanged="Number_Changed"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Минимум свободного места (ГБ)" Style="{StaticResource RowLabel}"/>
                                <NumberBox x:Name="MinFreeBox" Grid.Column="1" Minimum="1" Maximum="500"
                                           SpinButtonPlacementMode="Compact" MinWidth="160"
                                           ValueChanged="Number_Changed"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Записи раскладываются по папкам игр автоматически. Шаблон имени файла и другие тонкие настройки — в settings.json."
                           Style="{StaticResource RowSub}" Margin="0,4,0,16"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Padding="28,10,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DirtyText" Style="{StaticResource RowSub}" VerticalAlignment="Center" Margin="0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="Открыть папку записей" Click="OpenFolder_Click"/>
                <Button x:Name="RevertBtn" Content="Отменить" Click="Revert_Click"/>
                <Button x:Name="ApplyBtn" Content="Применить" Style="{StaticResource AccentButtonStyle}"
                        MinWidth="110" Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
