<Page
    x:Class="InstantReplay.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Padding="28,12,28,0">
            <StackPanel Spacing="10" HorizontalAlignment="Stretch">

            <!-- Состояние. Всё в одну колонку: правый столбец с длинным текстом
                 налезал на полосу буфера и выглядел сломанным. -->
            <Grid Style="{StaticResource SettingCard}">
                <StackPanel Spacing="14">

                    <!-- Строка 1: статус слева, плашка с игрой справа -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="StateDot" Width="11" Height="11"
                                         VerticalAlignment="Center" Fill="Gray"/>
                                <TextBlock x:Name="StateText" Text="Выключено" FontSize="22" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="StateSub" Style="{StaticResource RowSub}" Margin="21,0,12,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Column="1" CornerRadius="8" Padding="14,8,16,9" VerticalAlignment="Center"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7FC;" FontSize="15" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Spacing="1" MaxWidth="240">
                                    <TextBlock Text="В фокусе" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="GameText" Text="—" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Строка 2: буфер -->
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BufferLabel" Text="Буфер повтора" FontSize="12.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="BufferText" Grid.Column="1" Text="пуст" FontSize="12.5"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <ProgressBar x:Name="BufferBar" Height="6" Minimum="0" Maximum="100"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Быстрые действия: то, ради чего приложение вообще открывают.
                 Под каждой кнопкой — её горячая клавиша. -->
            <TextBlock Text="Быстрые действия" Style="{StaticResource SectionHeader}" Margin="0,12,0,2"/>
            <Grid Style="{StaticResource SettingCard}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="SaveReplayBtn" Click="SaveReplay_Click" MinWidth="210"
                            Style="{StaticResource AccentButtonStyle}" Padding="16,10,16,11">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74E;" FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Сохранить повтор" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SaveReplayHint" FontSize="11" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="Save30Btn" Click="SaveLast30_Click" MinWidth="200" Padding="16,10,16,11">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE916;" FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Последние 30 секунд" FontWeight="SemiBold"/>
                                <TextBlock x:Name="Save30Hint" FontSize="11" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RecordBtn" Click="Record_Click" MinWidth="200" Padding="16,10,16,11">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse x:Name="RecordDot" Width="10" Height="10" VerticalAlignment="Center" Fill="Gray"/>
                            <StackPanel>
                                <TextBlock x:Name="RecordText" Text="Начать запись" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RecordHint" FontSize="11" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Последние записи: попасть в клип за один клик -->
            <Grid Margin="0,12,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Последние записи" Style="{StaticResource SectionHeader}" Margin="0"/>
                <HyperlinkButton Grid.Column="1" Content="Вся панорама" Click="OpenClips_Click"
                                 VerticalAlignment="Bottom"/>
            </Grid>
            <Grid Style="{StaticResource SettingCard}">
                <StackPanel Spacing="10">
                    <StackPanel x:Name="RecentPanel" Orientation="Horizontal" Spacing="12"/>
                    <TextBlock x:Name="RecentEmpty" Style="{StaticResource RowSub}" Margin="0"
                               Text="Записей пока нет — сохрани первый повтор горячей клавишей."/>
                </StackPanel>
            </Grid>

            <!-- Хранилище -->
            <TextBlock Text="Хранилище" Style="{StaticResource SectionHeader}" Margin="0,12,0,2"/>
            <Grid Style="{StaticResource SettingCard}" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StorageMain" Text="—" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StorageFree" Grid.Column="1" Text="" FontSize="13"
                                   VerticalAlignment="Bottom"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="StorageBar" Height="6" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="StorageSub" Style="{StaticResource RowSub}" Margin="0"/>
                </StackPanel>
            </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель: самое частое действие после сохранения клипа -->
        <Grid Grid.Row="1" Padding="28,10,28,14">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Click="OpenClips_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE786;" FontSize="13"/>
                        <TextBlock Text="Панорама записей"/>
                    </StackPanel>
                </Button>
                <Button Click="OpenFolder_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                        <TextBlock Text="Открыть папку записей"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
