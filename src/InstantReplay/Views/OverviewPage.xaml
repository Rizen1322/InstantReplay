<Page
    x:Class="InstantReplay.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Padding="28,12,28,0">
            <StackPanel Spacing="10" HorizontalAlignment="Stretch">

            <!-- Только буфер: состояние записи постоянно видно в шапке окна,
                 дублировать его карточкой ни к чему. -->
            <Grid Style="{StaticResource SettingCard}">
                <StackPanel Spacing="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BufferLabel" Text="Буфер повтора" FontSize="12.5"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="BufferText" Grid.Column="1" Text="пуст" FontSize="12.5"
                                   FontWeight="SemiBold"/>
                    </Grid>
                    <ProgressBar x:Name="BufferBar" Height="6" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Grid>

            <!-- Последние записи: попасть в клип за один клик -->
            <Grid Margin="0,12,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Последние записи" Style="{StaticResource SectionHeader}" Margin="0"/>
                <HyperlinkButton Grid.Column="1" Content="Вся панорама" Click="OpenClips_Click"
                                 VerticalAlignment="Bottom"/>
            </Grid>
            <Grid Style="{StaticResource SettingCard}">
                <StackPanel Spacing="10">
                    <StackPanel x:Name="RecentPanel" Orientation="Horizontal" Spacing="12"/>
                    <TextBlock x:Name="RecentEmpty" Style="{StaticResource RowSub}" Margin="0"
                               Text="Записей пока нет — сохрани первый повтор горячей клавишей."/>
                </StackPanel>
            </Grid>

            <!-- Хранилище -->
            <TextBlock Text="Хранилище" Style="{StaticResource SectionHeader}" Margin="0,12,0,2"/>
            <Grid Style="{StaticResource SettingCard}" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StorageMain" Text="—" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StorageFree" Grid.Column="1" Text="" FontSize="13"
                                   VerticalAlignment="Bottom"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="StorageBar" Height="6" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="StorageSub" Style="{StaticResource RowSub}" Margin="0"/>
                </StackPanel>
            </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель: самое частое действие после сохранения клипа -->
        <Grid Grid.Row="1" Padding="28,10,28,14">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Click="OpenClips_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE786;" FontSize="13"/>
                        <TextBlock Text="Панорама записей"/>
                    </StackPanel>
                </Button>
                <Button Click="OpenFolder_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                        <TextBlock Text="Открыть папку записей"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
