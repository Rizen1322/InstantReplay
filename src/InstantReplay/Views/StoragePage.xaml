<Page
    x:Class="InstantReplay.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Padding="28,12,28,0">
            <StackPanel Spacing="10" HorizontalAlignment="Stretch">

                <!-- Статистика первой: главное на этой вкладке — сколько занято
                     и близко ли автоочистка. Настройки ниже меняют редко. -->
                <TextBlock Text="Статистика" Style="{StaticResource SectionHeader}"/>
                <Grid Style="{StaticResource SettingCard}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="SavedCountText" Text="0" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="повторов сохранено" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="UsedText" Text="0,0 ГБ" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="занято на диске" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock x:Name="FreeText" Text="—" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="свободно" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="UsagePanel" Spacing="4" Margin="0,6,0,0">
                            <ProgressBar x:Name="UsageBar" Height="6" Minimum="0" Maximum="100"/>
                            <TextBlock x:Name="UsageText" Style="{StaticResource RowSub}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Папка записей" Style="{StaticResource SectionHeader}" Margin="0,16,0,2"/>
                <Grid Style="{StaticResource SettingCard}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Путь сохранения" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="PathText" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Выбрать…" Click="Browse_Click" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Раскладывать по папкам игр" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Videos\InstantReplay\Counter-Strike 2\…" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="GroupToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                          HorizontalAlignment="Right" MinWidth="0" Toggled="Setting_Changed"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Шаблон имени файла" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Плейсхолдеры: {game} {date} {time} {preset}" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <TextBox x:Name="TemplateBox" Grid.Column="1" MinWidth="280" VerticalAlignment="Center"
                                     TextChanged="Text_Changed"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Автоудаление старых записей" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="Удаляет самые старые при достижении лимита" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoDeleteToggle" Grid.Column="1" OnContent="Вкл." OffContent="Откл."
                                          HorizontalAlignment="Right" MinWidth="0" Toggled="Setting_Changed"/>
                        </Grid>

                        <!-- Лимиты нужны только при включённом автоудалении: без него
                             цифра «лимит папки» ни на что не влияет и только путает. -->
                        <StackPanel x:Name="LimitsPanel" Spacing="16" Visibility="Collapsed">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Лимит размера папки (ГБ)" Style="{StaticResource RowLabel}"/>
                                <NumberBox x:Name="MaxFolderBox" Grid.Column="1" Minimum="0" Maximum="5000"
                                           SpinButtonPlacementMode="Compact" MinWidth="160"
                                           ValueChanged="Number_Changed"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Минимум свободного места (ГБ)" Style="{StaticResource RowLabel}"/>
                                <NumberBox x:Name="MinFreeBox" Grid.Column="1" Minimum="1" Maximum="500"
                                           SpinButtonPlacementMode="Compact" MinWidth="160"
                                           ValueChanged="Number_Changed"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Padding="28,10,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DirtyText" Style="{StaticResource RowSub}" VerticalAlignment="Center" Margin="0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="Открыть папку записей" Click="OpenFolder_Click"/>
                <Button x:Name="RevertBtn" Content="Отменить" Click="Revert_Click"/>
                <Button x:Name="ApplyBtn" Content="Применить" Style="{StaticResource AccentButtonStyle}"
                        MinWidth="110" Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
