<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Сжатие содержимого single-file: и рантайм, и payload.zip, и музыка -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Установщику не нужны ICU-данные (~28 МБ) и чужие языковые ресурсы -->
    <!-- Не invariant: со шрифтами Aura (Golos, Onest) WPF читает языковые таблицы
         OpenType и в invariant-режиме падает на культуре "en". -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>..\Aura\Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Имя файла НЕ МЕНЯТЬ: установленные версии 1.0.x ищут в релизе
         именно InstantReplaySetup.exe и по нему обновляются. -->
    <AssemblyName>InstantReplaySetup</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Значок приложения показывается и в установщике: один файл на оба,
         чтобы установщик не расходился с иконкой в меню «Пуск». -->
    <Resource Include="..\Aura\Assets\logo.png" Link="Assets\logo.png" />
    <!-- Шрифты самой Aura: установщик выглядит как приложение -->
    <Resource Include="..\Aura\Fonts\GolosText-Regular.ttf" Link="Fonts\GolosText-Regular.ttf" />
    <Resource Include="..\Aura\Fonts\GolosText-Medium.ttf" Link="Fonts\GolosText-Medium.ttf" />
    <Resource Include="..\Aura\Fonts\GolosText-SemiBold.ttf" Link="Fonts\GolosText-SemiBold.ttf" />
    <Resource Include="..\Aura\Fonts\Onest-SemiBold.ttf" Link="Fonts\Onest-SemiBold.ttf" />
    <Resource Include="..\Aura\Fonts\Onest-Bold.ttf" Link="Fonts\Onest-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fully managed MP3 decode + WinMM output: no Windows Media Player dependency. -->
    <PackageReference Include="NAudio.Core" Version="2.3.0" />
    <PackageReference Include="NAudio.WinMM" Version="2.3.0" />
    <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />

    <!-- Полезная нагрузка (bin приложения) кладётся скриптом build_setup.ps1 в dist\payload.zip -->
    <EmbeddedResource Include="..\..\dist\payload.zip" Link="payload.zip" Condition="Exists('..\..\dist\payload.zip')" />
    <!-- Компактная музыка всегда входит в установщик и воспроизводится тихо. -->
    <EmbeddedResource Include="Assets\setup_music.mp3" Link="setup_music.mp3" />
  </ItemGroup>
</Project>
