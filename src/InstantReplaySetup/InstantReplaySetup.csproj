<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Сжатие содержимого single-file: и рантайм, и payload.zip, и музыка -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Установщику не нужны ICU-данные (~28 МБ) и чужие языковые ресурсы -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>..\InstantReplay\Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InstantReplaySetup</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Полезная нагрузка (bin приложения) кладётся скриптом build_setup.ps1 в dist\payload.zip -->
    <EmbeddedResource Include="..\..\dist\payload.zip" Link="payload.zip" Condition="Exists('..\..\dist\payload.zip')" />
    <!-- Музыка установщика: setup_music.wav из корня репозитория -->
    <EmbeddedResource Include="..\..\setup_music.wav" Link="setup_music.wav" Condition="Exists('..\..\setup_music.wav')" />
  </ItemGroup>
</Project>
