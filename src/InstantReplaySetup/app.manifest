<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="InstantReplaySetup.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker, а права администратора установщик просит сам при запуске
             (App.EnsureElevated). С requireAdministrator обновление из Aura падало
             с «Отказано в доступе»: у Aura есть package identity (sparse-пакет),
             а упакованному процессу Windows не даёт запускать exe, которые требуют
             повышения, без capability allowElevation. Aura и так работает от
             администратора, поэтому при обновлении права просто наследуются. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
