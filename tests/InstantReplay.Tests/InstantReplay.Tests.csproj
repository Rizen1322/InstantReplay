<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>InstantReplay.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    Файлы приложения компилируются в тест ПРЯМОЙ ССЫЛКОЙ НА ИСХОДНИКИ, а не через
    ProjectReference: сам InstantReplay — WinUI-приложение под net9.0-windows10.x,
    и ссылка на него притащила бы в тестовый хост весь Windows App SDK.
    Сюда попадает только логика без UI и без графики — её и проверяем.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\InstantReplay\Core\Hotkeys\HotkeyAction.cs" Link="App\HotkeyAction.cs" />
    <Compile Include="..\..\src\InstantReplay\Core\Hotkeys\HotkeyParser.cs" Link="App\HotkeyParser.cs" />
    <Compile Include="..\..\src\InstantReplay\Core\Hotkeys\HotkeyConflicts.cs" Link="App\HotkeyConflicts.cs" />
    <Compile Include="..\..\src\InstantReplay\Core\Settings\AppSettings.cs" Link="App\AppSettings.cs" />
    <Compile Include="..\..\src\InstantReplay\Core\Storage\ByteSize.cs" Link="App\ByteSize.cs" />
    <Compile Include="..\..\src\InstantReplay\Core\Storage\ClipIndex.cs" Link="App\ClipIndex.cs" />
    <Compile Include="..\..\src\InstantReplay\Core\Storage\FileNaming.cs" Link="App\FileNaming.cs" />
    <Compile Include="..\..\src\InstantReplay\Core\Library\ClipGrouping.cs" Link="App\ClipGrouping.cs" />
    <Compile Include="..\..\src\InstantReplay\Core\Buffering\ReplayBuffers.cs" Link="App\ReplayBuffers.cs" />
    <Compile Include="..\..\src\InstantReplay\Core\Logging\Log.cs" Link="App\Log.cs" />
  </ItemGroup>

</Project>
